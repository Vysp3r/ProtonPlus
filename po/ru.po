#~ msgid ""
#~ "Enables DXVK's asynchronous pipeline compilation which can reduce "
#~ "stuttering."
#~ msgstr ""
#~ "Включает асинхронную компиляцию конвейеров DXVK, что может уменьшить "
#~ "микрозаикания."

#~ msgid "Disable DXVK logging"
