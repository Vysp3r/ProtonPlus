#~ "поддержкой Reflex."

#~ msgid ""
#~ "Enables the NVIDIA Vulkan Reflex layer for games that support "
#~ "VK_NV_low_latency2."
#~ msgstr ""
#~ "Включает слой NVIDIA Vulkan Reflex для игр, поддерживающих "
#~ "VK_NV_low_latency2."

#~ msgid "Adds -skip-launcher to bypass launchers in games that support it."
#~ msgstr ""
#~ "Добавляет -skip-launcher для обхода лаунчеров в играх, которые это "
#~ "поддерживают."

#~ msgid "Adds -vulkan to make the game use its Vulkan renderer."
#~ msgstr "Добавляет -vulkan, чтобы игра использовала свой рендерер Vulkan."

#~ msgid "Adds -dx11 to make the game use its DirectX 11 renderer."
#~ msgstr "Добавляет -dx11, чтобы игра использовала свой рендерер DirectX 11."

#~ msgid "Adds -dx12 to make the game use its DirectX 12 renderer."
#~ msgstr "Добавляет -dx12, чтобы игра использовала свой рендерер DirectX 12."

