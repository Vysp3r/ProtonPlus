#~ msgstr ""
#~ "Добавляет -console для открытия консоли разработчика игры, когда это "
#~ "поддерживается."

#~ msgid "Makes the game use the AMD dGPU on hybrid systems."
#~ msgstr ""
#~ "Заставляет игру использовать дискретную ГП AMD в гибридных системах."

#~ msgid ""
#~ "Makes Proton report an AMD APU as a discrete GPU for games that mis-"
#~ "detect integrated graphics."
