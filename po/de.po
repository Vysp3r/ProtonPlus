#: src/launch-options/launch-option-catalog.vala:1332
msgid "Adds -dx12."
msgstr "Fügt -dx12 hinzu."

#: src/launch-options/launch-option-catalog.vala:1333
msgid "Developer console"
msgstr "Entwicklerkonsole"

#: src/launch-options/launch-option-catalog.vala:1333
msgid "Adds -console when the game supports it."
msgstr ""
"Fügt „-console“ hinzu, um die Entwicklerkonsole des Spiels zu öffnen, sofern "
"dies unterstützt wird."

#: src/launch-options/launch-option-catalog.vala:1334
