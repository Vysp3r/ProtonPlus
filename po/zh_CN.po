#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:132
msgid "✨ Added a new \"Downloads\" tab"
msgstr "✨ 新增“下载”选项卡"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:133
msgid "✨ Added more launch options"
msgstr "✨ 添加了更多的启动选项"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:134
msgid "✨ Added a \"Run custom executable\" button"
msgstr "✨ 新增“运行自定义可执行程序”选项"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:135
msgid "✨ Added a SteamOS theme and an OLED theme"
msgstr "✨ 新增了 SteamOS 主题和 OLED 主题"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:136
msgid "🐛 Fixed DXVK-Sarek"
msgstr "🐛 修复了 DXVK-Sarek"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:137
msgid "🐛 Fixed tool usage count to account for default tool"
msgstr "🐛 修正工具使用次数，以计入默认工具"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:138
msgid "🐛 Fixed tool usage count to account for non-steam games"
msgstr "🐛 修正了工具使用次数统计，以涵盖非Steam游戏"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:139
msgid ""
"🐛 Fixed an error that occured when installing a tool in any launcher except "
"for Steam"
msgstr "🐛 修复了在除 Steam 之外的任何启动器中安装工具时出现的错误。"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:149
msgid "🐛 Fixed launchers not being detected on certain distro"
msgstr "🐛 修复了某些发行版无法检测到启动器的问题"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:159
msgid ""
"✨ Improved the launch options, mass edit and default compatibility tool view"
msgstr "✨ 改进了启动选项、批量编辑和默认兼容性工具视图"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:160
msgid "✨ Removed Proton-Sarek"
msgstr "✨ 移除了 Proton-Sarek"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:161
msgid "🐛 Fixed a few typos"
msgstr "🐛 修复了一点点拼写错误"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:162
msgid "🐛 Fixed broken icons"
msgstr "🐛 修复了损坏的图标"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:163
msgid "🐛 Fixed XDG base directory specification"
msgstr "🐛 修复了 XDG 基本目录规范"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:164
msgid "🐛 Fixed Proton-CachyOS (Temporary fix)"
msgstr "🐛 修复了 Proton-CachyOS（临时）"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:165
msgid "🐛 Fixed Latest releases for Bottles"
msgstr "🐛 修复了 Bottles 的最新版本"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:166
msgid "🐛 Fixed updates not preserving symlink for user_settings.py"
msgstr "🐛 修复了更新后 user_settings.py 的符号链接无法保留的问题"

