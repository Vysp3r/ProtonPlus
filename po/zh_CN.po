#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:215
msgid "✨ Added DW-Proton"
msgstr "✨ 新增 DW-Proton"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:224
msgid "✨ Migrate user_settings.py on update"
msgstr "✨ 更新时迁移 user_settings.py"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:225
msgid "✨ Added a button to open runners install directory"
msgstr "✨ 添加了一个按钮，用于打开运行器的安装目录"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:226
msgid "✨ Added a basic cache system for downloaded runners"
msgstr "✨ 为下载的运行器添加了基本的缓存系统"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:227
msgid "✨ Improved new user experience"
msgstr "✨ 改进了新用户体验"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:228
msgid "✨ Added API limit/connection issue warning dialog"
msgstr "✨ 新增 API 限制/连接问题警告对话框"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:229
msgid "✨ Improved \"Runners\" tab filters"
msgstr "✨ 改进了“运行器”标签页筛选器"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:230
msgid "✨ Added preferences dialog"
msgstr "✨ 添加了首选项对话框"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:231
