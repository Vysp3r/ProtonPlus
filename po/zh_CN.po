msgid "🐛 Fixed select/unselect all"
msgstr "🐛 修复了全选/取消全选的问题"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:236
msgid "🐛 Fixed Proton-CachyOS not downloading the good version"
msgstr "🐛 修复了 Proton-CachyOS 无法下载正确版本的问题"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:237
