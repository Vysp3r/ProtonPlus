msgid "Steam no longer needs to restart"
msgstr "Steam tidak lagi perlu restart"

#: src/widgets/main/steam-restart-presentation.vala:110
msgid "Steam status couldn’t be confirmed"
msgstr "Status Steam tidak dapat dikonfirmasi"

#: src/widgets/main/steam-restart-presentation.vala:110
msgid "ProtonPlus did not restart Steam. Try again or restart it manually."
msgstr "ProtonPlus tidak merestart Steam. Coba lagi atau restart secara manual."

