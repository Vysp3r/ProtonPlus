msgstr "Dinonaktifkan"

#: src/widgets/games/launch-options-editor/groups/audio-options-group.vala:41
msgid "WINEALSA Channels"
msgstr "Saluran WINEALSA"

#: src/widgets/games/launch-options-editor/groups/audio-options-group.vala:42
msgid ""
"Sets the number of ALSA output channels used by Wine. Available from GE-"
"Proton11-1."
msgstr ""
"Mengatur jumlah saluran output ALSA yang digunakan oleh Wine. Tersedia sejak "
"GE-Proton11-1."

#: src/widgets/games/launch-options-editor/groups/audio-options-group.vala:56
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1317
msgid "Wine ALSA spatial downmix"
msgstr "Downmix spasial Wine ALSA"

#: src/widgets/games/launch-options-editor/groups/audio-options-group.vala:57
msgid ""
"Enables spatial mixing in Wine ALSA audio output. Requires WINEALSA Channels "
"set to 4, 6, or 8. Available from GE-Proton11-1."
msgstr ""
"Mengaktifkan pencampuran spasial pada output audio Wine ALSA. Memerlukan "
"Saluran WINEALSA diatur ke 4, 6, atau 8. Tersedia sejak GE-Proton11-1."

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:16
msgid "Common options"
msgstr "Opsi umum"

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:17
msgid "Quick toggles for the launch options people reach for most often."
msgstr "Sakelar cepat untuk opsi peluncuran yang paling sering digunakan."

#. Performance & monitoring
#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:20
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1231
msgid "MangoHud performance overlay"
msgstr "Overlay kinerja MangoHud"

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:21
msgid "Shows an in-game overlay with FPS, CPU/GPU usage, and temps."
msgstr ""
"Menampilkan overlay dalam game dengan FPS, penggunaan CPU/GPU, dan suhu."

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:30
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1242
msgid "Use desktop game profile"
msgstr "Gunakan profil game desktop"

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:31
msgid "Disables the Steam Deck-specific profile that some games use."
msgstr "Menonaktifkan profil khusus Steam Deck yang digunakan beberapa game."

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:39
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1241
msgid "Native Wayland"
msgstr "Wayland Native"

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:40
msgid ""
"Runs the game natively on Wayland instead of through XWayland but it breaks "
"Steam Input and the Steam Overlay."
msgstr ""
"Menjalankan game secara native di Wayland alih-alih melalui XWayland, tetapi "
"merusak Steam Input dan Steam Overlay."

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:48
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1232
#: src/widgets/mangohud/mangohud-extras-page.vala:100
msgid "GameMode"
msgstr "GameMode"

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:49
msgid ""
"Requests temporary optimizations for system performance (CPU governor, "
"process priority) when the game is running."
msgstr ""
"Meminta optimasi sementara untuk kinerja sistem (gubernur CPU, prioritas "
"proses) saat game berjalan."

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:57
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1233
msgid "CachyOS game-performance profile"
msgstr "Profil kinerja game CachyOS"

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:58
msgid ""
"Uses CachyOS performance power and sched_ext gaming profiles until the game "
"exits."
msgstr ""
"Menggunakan daya kinerja CachyOS dan profil sched_ext untuk gaming hingga "
"game keluar."

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:63
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1234
msgid "MangoHud Vulkan environment mode"
msgstr "Mode lingkungan MangoHud Vulkan"

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:64
msgid ""
"Uses MANGOHUD=1 for Vulkan only. Prefer the MangoHud wrapper when OpenGL "
"support is needed."
msgstr ""
"Menggunakan MANGOHUD=1 khusus untuk Vulkan. Lebih baik gunakan wrapper "
"MangoHud bila diperlukan dukungan OpenGL."

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:69
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1235
msgid "OBS Vulkan/OpenGL capture"
msgstr "Pengambilan OBS Vulkan/OpenGL"

#: src/widgets/games/launch-options-editor/groups/common-options-group.vala:70
msgid ""
"Loads obs-vkcapture. Install the native package, or both the Flatpak OBS "
"plugin and capture-tools layer."
msgstr ""
"Memuat obs-vkcapture. Instal paket native, atau plugin Flatpak OBS dan "
"lapisan capture-tools."

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:16
msgid "DXVK options"
msgstr "Opsi DXVK"

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:17
#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:20
#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:15
msgid "Extra graphics settings and launch behaviors."
msgstr "Pengaturan grafis ekstra dan perilaku peluncuran tambahan."

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:20
msgid "DXVK Async"
msgstr "DXVK Async"

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:21
msgid ""
"Enables DXVK's asynchronous pipeline compilation which can reduce stuttering."
msgstr ""
"Mengaktifkan kompilasi pipa asinkronus DXVK yang dapat mengurangi patah-"
"patah."

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:25
msgid "Disable DXVK logging"
msgstr "Nonaktifkan pencatatan DXVK"

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:26
msgid ""
"Sets DXVK's log level to none which can improve performance in some games."
msgstr ""
"Mengatur tingkat log DXVK ke none yang dapat meningkatkan kinerja di "
"beberapa game."

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:30
msgid "DXVK Frame Limit"
msgstr "Batas Frame DXVK"

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:31
msgid "Caps the frame rate using DXVK's built-in frame limiter."
msgstr "Membatasi laju frame menggunakan pembatas frame bawaan DXVK."

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:32
#: src/widgets/games/launch-options-editor/wrappers/gamescope.vala:42
#: src/widgets/games/launch-options-editor/wrappers/scopebuddy.vala:53
msgid "FPS"
msgstr "FPS"

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:43
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1280
msgid "Proton-CachyOS DX11 low latency"
msgstr "Proton-CachyOS DX11 latensi rendah"

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:44
msgid "Enables the custom DXVK low-latency path for Direct3D 9–11."
msgstr "Mengaktifkan jalur latensi rendah DXVK khusus untuk Direct3D 9–11."

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:49
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1282
msgid "Proton-CachyOS Vulkan Anti-Lag 2 layer"
msgstr "Lapisan Proton-CachyOS Vulkan Anti-Lag 2"

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:50
msgid ""
"Exposes VK_AMD_anti_lag to Vulkan games that already support Anti-Lag 2."
msgstr ""
"Menampilkan VK_AMD_anti_lag untuk game Vulkan yang sudah mendukung Anti-Lag "
"2."

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:55
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1283
msgid "Expose Vulkan Reflex instead of Anti-Lag 2"
msgstr "Tampilkan Vulkan Reflex alih-alih Anti-Lag 2"

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:56
msgid ""
"Switches the low-latency Vulkan layer to VK_NV_low_latency2 for games with "
"Reflex support."
msgstr ""
"Mengalihkan lapisan Vulkan latensi rendah ke VK_NV_low_latency2 untuk game "
"dengan dukungan Reflex."

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:61
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1284
msgid "Proton-CachyOS NVIDIA Reflex Vulkan layer"
msgstr "Lapisan Proton-CachyOS NVIDIA Reflex Vulkan"

#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:62
msgid ""
"Enables the NVIDIA Vulkan Reflex layer for games that support "
"VK_NV_low_latency2."
msgstr ""
"Mengaktifkan lapisan NVIDIA Vulkan Reflex untuk game yang mendukung "
"VK_NV_low_latency2."

#: src/widgets/games/launch-options-editor/groups/game-arguments-group.vala:14
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:357
msgid "Game arguments"
msgstr "Argumen game"

#: src/widgets/games/launch-options-editor/groups/game-arguments-group.vala:15
msgid "Flags passed directly to the game."
msgstr "Flag yang diteruskan langsung ke game."

#. Game arguments
#: src/widgets/games/launch-options-editor/groups/game-arguments-group.vala:18
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1320
msgid "Skip launcher"
msgstr "Lewati peluncur"

#: src/widgets/games/launch-options-editor/groups/game-arguments-group.vala:19
msgid "Adds -skip-launcher to bypass launchers in games that support it."
msgstr ""
"Menambahkan -skip-launcher untuk melewati launcher di game yang mendukungnya."

#: src/widgets/games/launch-options-editor/groups/game-arguments-group.vala:22
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1321
msgid "Vulkan renderer"
msgstr "Renderer Vulkan"

#: src/widgets/games/launch-options-editor/groups/game-arguments-group.vala:22
msgid "Adds -vulkan to make the game use its Vulkan renderer."
msgstr "Menambahkan -vulkan agar game menggunakan renderer Vulkan-nya."

#: src/widgets/games/launch-options-editor/groups/game-arguments-group.vala:23
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1322
msgid "DirectX 11 renderer"
msgstr "Renderer DirectX 11"

#: src/widgets/games/launch-options-editor/groups/game-arguments-group.vala:23
msgid "Adds -dx11 to make the game use its DirectX 11 renderer."
msgstr "Menambahkan -dx11 agar game menggunakan renderer DirectX 11-nya."

#: src/widgets/games/launch-options-editor/groups/game-arguments-group.vala:24
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1323
msgid "DirectX 12 renderer"
msgstr "Renderer DirectX 12"

#: src/widgets/games/launch-options-editor/groups/game-arguments-group.vala:24
msgid "Adds -dx12 to make the game use its DirectX 12 renderer."
msgstr "Menambahkan -dx12 agar game menggunakan renderer DirectX 12-nya."

#: src/widgets/games/launch-options-editor/groups/game-arguments-group.vala:25
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1324
msgid "Developer console"
msgstr "Konsol pengembang"

#: src/widgets/games/launch-options-editor/groups/game-arguments-group.vala:25
msgid "Adds -console to open the game's developer console when supported."
msgstr ""
"Menambahkan -console untuk membuka konsol pengembang game jika didukung."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:29
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1288
msgid "Mesa Anti-Lag"
msgstr "Mesa Anti-Lag"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:29
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1288
msgid "Reduces latency on supported AMD Mesa setups."
msgstr "Mengurangi latensi pada pengaturan AMD Mesa yang didukung."

#. Hardware & drivers
#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:30
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1287
msgid "Use discrete GPU"
msgstr "Gunakan GPU diskrit"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:30
msgid "Makes the game use the AMD dGPU on hybrid systems."
msgstr "Membuat game menggunakan dGPU AMD pada sistem hybrid."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:32
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1297
msgid "Treat APU as a discrete GPU"
msgstr "Anggap APU sebagai GPU diskrit"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:33
msgid ""
"Makes Proton report an AMD APU as a discrete GPU for games that mis-detect "
"integrated graphics."
msgstr ""
"Membuat Proton melaporkan APU AMD sebagai GPU diskrit untuk game yang salah "
"mendeteksi grafis terintegrasi."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:37
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1289
msgid "FSR 4 upgrade (current path)"
msgstr "Upgrade FSR 4 (jalur saat ini)"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:38
msgid ""
"Uses the selected custom Proton build's default FSR 4 release. Current "
"Proton-GE disables Anti-Lag 2 while active."
msgstr ""
"Menggunakan rilis FSR 4 bawaan dari build Proton khusus yang dipilih. Proton-"
"GE saat ini menonaktifkan Anti-Lag 2 saat aktif."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:46
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1290
msgid "FSR 4 RDNA3 upgrade (legacy path)"
msgstr "Upgrade FSR 4 RDNA3 (jalur warisan)"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:47
msgid ""
"Uses the older RDNA3 switch retained by some Proton-GE builds and removed "
"from current Proton-CachyOS."
msgstr ""
"Menggunakan sakelar RDNA3 lama yang dipertahankan oleh beberapa build Proton-"
"GE dan dihapus dari Proton-CachyOS saat ini."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:56
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1291
msgid "FSR 4 ML frame generation"
msgstr "Generasi frame ML FSR 4"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:57
msgid ""
"Requires FSR 4.0.3 or newer. RDNA3 may also need "
"DXIL_SPIRV_CONFIG=wmma_rdna3_workaround."
msgstr ""
"Memerlukan FSR 4.0.3 atau lebih baru. RDNA3 mungkin juga memerlukan "
"DXIL_SPIRV_CONFIG=wmma_rdna3_workaround."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:61
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1292
msgid "RDNA3 ML frame-generation workaround"
msgstr "Workaround generasi frame ML RDNA3"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:62
msgid ""
"Applies the DXIL-SPIR-V WMMA workaround only when RDNA3 ML frame generation "
"needs it."
msgstr ""
"Menerapkan workaround DXIL-SPIR-V WMMA hanya ketika generasi frame ML RDNA3 "
"memerlukannya."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:67
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1293
msgid "AMD Reflex preset: allow DXVK-NVAPI"
msgstr "Preset AMD Reflex: izinkan DXVK-NVAPI"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:68
msgid ""
"Least-invasive preset. Allows DXVK-NVAPI on AMD; try this before GPU "
"spoofing."
msgstr ""
"Preset paling tidak invasif. Mengizinkan DXVK-NVAPI pada AMD; coba ini "
"sebelum spoofing GPU."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:73
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1294
msgid "AMD Reflex preset: hide AMD GPU"
msgstr "Preset AMD Reflex: sembunyikan GPU AMD"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:74
msgid ""
"DXVK fallback that can expose Reflex but can break FSR 4 and ML frame "
"generation."
msgstr ""
"Fallback DXVK yang dapat menampilkan Reflex tetapi dapat merusak FSR 4 dan "
"generasi frame ML."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:79
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1295
msgid "AMD Reflex preset: force NVAPI"
msgstr "Preset AMD Reflex: paksa NVAPI"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:80
msgid ""
"Invasive fallback for games that still hide Reflex. Can break FSR 4 and game "
"GPU detection."
msgstr ""
"Fallback invasif untuk game yang masih menyembunyikan Reflex. Dapat merusak "
"FSR 4 dan deteksi GPU game."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:85
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1296
msgid "AMD Reflex preset: layer NVIDIA spoof"
msgstr "Preset AMD Reflex: lapisan spoof NVIDIA"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:86
msgid ""
"Last-resort spoof discouraged by upstream because it can break Proton FSR 4."
msgstr ""
"Spoof jalan terakhir yang tidak disarankan oleh upstream karena dapat "
"merusak Proton FSR 4."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:92
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1299
msgid "Staging shared memory"
msgstr "Memori bersama staging"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:93
msgid ""
"Enables shared memory support in the AMD GPU driver for better performance "
"in some games."
msgstr ""
"Mengaktifkan dukungan memori bersama di driver GPU AMD untuk kinerja lebih "
"baik di beberapa game."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:97
msgid "Mesa GLThread"
msgstr "Mesa GLThread"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:98
msgid ""
"Enables Mesa's GLThread optimization for better performance in some games."
msgstr ""
"Mengaktifkan optimasi GLThread Mesa untuk kinerja lebih baik di beberapa "
"game."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:103
msgid "Disable Mesa shader cache"
msgstr "Nonaktifkan cache shader Mesa"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:104
msgid "Disables Mesa's shader cache which can cause stuttering in some games."
msgstr ""
"Menonaktifkan cache shader Mesa yang dapat menyebabkan patah-patah di "
"beberapa game."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:125
msgid ""
"Configure RADV debug options for troubleshooting and performance testing."
msgstr ""
"Konfigurasi opsi debug RADV untuk pemecahan masalah dan pengujian kinerja."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:127
msgid ""
"Configure RADV performance test options for testing experimental driver "
"features. Use with caution as these features can cause instability or other "
"issues."
msgstr ""
"Konfigurasi opsi uji kinerja RADV untuk menguji fitur driver eksperimental. "
"Gunakan dengan hati-hati karena fitur ini dapat menyebabkan ketidakstabilan "
"atau masalah lain."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:130
msgid ""
"Select which AMD Vulkan driver to use. This can be used to switch between "
"RADV and AMD's official Vulkan driver on supported systems."
msgstr ""
"Pilih driver Vulkan AMD yang akan digunakan. Ini dapat digunakan untuk "
"beralih antara RADV dan driver Vulkan resmi AMD pada sistem yang didukung."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-amd-options-group.vala:133
msgid ""
"Configure ACO compiler debug options to troubleshoot shader compilation "
"issues, fix in-game stuttering, or analyze graphics performance. Use with "
"caution."
msgstr ""
"Konfigurasi opsi debug kompiler ACO untuk memecahkan masalah kompilasi "
"shader, memperbaiki patah-patah dalam game, atau menganalisis kinerja "
"grafis. Gunakan dengan hati-hati."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-intel-options-group.vala:10
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1310
msgid "XeSS component upgrade"
msgstr "Peningkatan komponen XeSS"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-intel-options-group.vala:10
msgid "Upgrades XeSS in supported games."
msgstr "Mengupgrade XeSS di game yang didukung."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-nvidia-options-group.vala:18
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1305
msgid "NVAPI"
msgstr "NVAPI"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-nvidia-options-group.vala:18
msgid "Lets games access NVIDIA-specific features like DLSS."
msgstr "Memungkinkan game mengakses fitur khusus NVIDIA seperti DLSS."

#. gpu_vendor_bindings.append (new LaunchOptionBinding ({ "PROTON_ENABLE_NVAPI=1" }, nvapi_tile.toggle));
#: src/widgets/games/launch-options-editor/groups/gpu-vendor-nvidia-options-group.vala:24
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1306
msgid "DLSS component updates"
msgstr "Pembaruan komponen DLSS"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-nvidia-options-group.vala:25
msgid "Auto upgrades DLSS components for supported games."
msgstr "Memperbarui komponen DLSS secara otomatis untuk game yang didukung."

#. gpu_vendor_bindings.append (new LaunchOptionBinding ({ "PROTON_ENABLE_NGX_UPDATER=1" }, nvidia_ngx_updater_tile.toggle));
#: src/widgets/games/launch-options-editor/groups/gpu-vendor-nvidia-options-group.vala:33
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1309
msgid "Report GPU as AMD"
msgstr "Laporkan GPU sebagai AMD"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-nvidia-options-group.vala:34
msgid ""
"Makes Proton report an NVIDIA GPU as AMD for games that expect Windows-only "
"NVIDIA driver behavior."
msgstr ""
"Membuat Proton melaporkan GPU NVIDIA sebagai AMD untuk game yang "
"mengharapkan perilaku driver NVIDIA khusus Windows."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-nvidia-options-group.vala:37
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1307
msgid "DLSS indicator"
msgstr "Indikator DLSS"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-nvidia-options-group.vala:37
msgid "Shows a DLSS status indicator in-game."
msgstr "Menampilkan indikator status DLSS dalam game."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-nvidia-options-group.vala:39
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1308
msgid "NVIDIA libraries"
msgstr "Pustaka NVIDIA"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-nvidia-options-group.vala:40
msgid ""
"Enables NVIDIA-specific libraries (PhysX, CUDA). This is not needed for DLSS "
"or ray tracing."
msgstr ""
"Mengaktifkan pustaka khusus NVIDIA (PhysX, CUDA). Ini tidak diperlukan untuk "
"DLSS atau ray tracing."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:25
msgid "GPU vendor options"
msgstr "Opsi vendor GPU"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:29
msgid ""
"Use GPU-specific compatibility toggles for AMD, NVIDIA and Intel hardware."
msgstr ""
"Gunakan sakelar kompatibilitas khusus GPU untuk perangkat keras AMD, NVIDIA, "
"dan Intel."

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:55
#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:71
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1287
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1288
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1289
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1290
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1291
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1292
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1297
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1298
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1299
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1300
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1301
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1302
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1303
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1304
msgid "AMD"
msgstr "AMD"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:56
#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:75
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1305
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1306
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1307
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1308
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1309
msgid "NVIDIA"
msgstr "NVIDIA"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:57
#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:79
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1310
msgid "Intel"
msgstr "Intel"

#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:89
#, c-format
msgid "Use GPU-specific compatibility toggles for %s hardware."
msgstr "Gunakan sakelar kompatibilitas khusus GPU untuk perangkat keras %s."

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:19
msgid "More options"
msgstr "Opsi lainnya"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:22
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1243
msgid "vkBasalt visual effects"
msgstr "Efek visual vkBasalt"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:22
msgid "Adds visual effects like sharpening and color adjustments."
msgstr "Menambahkan efek visual seperti penajaman dan penyesuaian warna."

#. Proton & Wine compatibility
#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:24
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1262
msgid "OpenGL fallback (WineD3D)"
msgstr "Fallback OpenGL (WineD3D)"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:25
msgid ""
"Uses OpenGL instead of Vulkan. Only enable if you're having DXVK issues."
msgstr ""
"Menggunakan OpenGL alih-alih Vulkan. Aktifkan hanya jika Anda mengalami "
"masalah DXVK."

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:30
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1264
msgid "NTSync mode"
msgstr "Mode NTSync"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:31
msgid ""
"Uses FSync instead of NTSync. Can fix issues in certain games that do not "
"pair well with NTSync."
msgstr ""
"Menggunakan FSync alih-alih NTSync. Dapat memperbaiki masalah di game "
"tertentu yang tidak cocok dengan NTSync."

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:36
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1237
msgid "Per-game shader cache"
msgstr "Cache shader per-game"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:37
msgid ""
"Enables per-game shader cache. This isolates the shader cache of each game "
"but does not compile them ahead-of-time."
msgstr ""
"Mengaktifkan cache shader per-game. Ini mengisolasi cache shader setiap game "
"tetapi tidak mengompilasinya sebelumnya."

#. Input & audio
#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:41
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1313
msgid "Prefer SDL controller input"
msgstr "Utamakan input kontroler SDL"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:41
msgid "Workaround for controller detection issues."
msgstr "Workaround untuk masalah deteksi kontroler."

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:43
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1314
msgid "Bypass Steam Input"
msgstr "Lewati Steam Input"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:44
msgid "Disables Steam Input support. Fixes Wayland controller/gamepad issues."
msgstr ""
"Menonaktifkan dukungan Steam Input. Memperbaiki masalah kontroler/gamepad "
"Wayland."

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:48
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1268
msgid "Vulkan synchronization 2"
msgstr "Sinkronisasi Vulkan 2"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:49
msgid ""
"Enables WINE_VK_USE_SYNC2 which can improve performance and reduce "
"stuttering in some games when using WineD3D."
msgstr ""
"Mengaktifkan WINE_VK_USE_SYNC2 yang dapat meningkatkan kinerja dan "
"mengurangi patah-patah di beberapa game saat menggunakan WineD3D."

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:53
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1269
msgid "Futex waitv synchronization"
msgstr "Sinkronisasi futex waitv"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:54
msgid ""
"Enables WINE_SYNC_USE_FUTEX_WAITV which can improve performance and reduce "
"stuttering in some games when using WineD3D."
msgstr ""
"Mengaktifkan WINE_SYNC_USE_FUTEX_WAITV yang dapat meningkatkan kinerja dan "
"mengurangi patah-patah di beberapa game saat menggunakan WineD3D."

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:58
msgid "Simulate Write-Copy Memory"
msgstr "Simulasi Memori Write-Copy"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:59
msgid ""
"Forces Wine to simulate page-write protection, fixing initialization errors "
"in certain older titles."
msgstr ""
"Memaksa Wine mensimulasikan proteksi tulis-halaman, memperbaiki kesalahan "
"inisialisasi di beberapa judul lama."

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:18
msgid "Proton options"
msgstr "Opsi Proton"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:19
msgid "Extra Proton settings and launch behaviors."
msgstr "Pengaturan Proton tambahan dan perilaku peluncuran."

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:22
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1236
msgid "High process priority"
msgstr "Prioritas proses tinggi"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:23
msgid ""
"Gives the game a higher CPU priority which can improve performance in some "
"cases."
msgstr ""
"Memberikan game prioritas CPU lebih tinggi yang dapat meningkatkan kinerja "
"dalam beberapa kasus."

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:27
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1266
msgid "WoW64 mode"
msgstr "Mode WoW64"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:28
msgid ""
"Enables WoW64 support for 32-bit games on 64-bit Proton builds. This can "
"improve compatibility for some older games."
msgstr ""
"Mengaktifkan dukungan WoW64 untuk game 32-bit pada build Proton 64-bit. Ini "
"dapat meningkatkan kompatibilitas untuk beberapa game lama."

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:32
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1265
msgid "Large address awareness for 32-bit games"
msgstr "Kesadaran alamat besar untuk game 32-bit"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:33
msgid ""
"Forces 32-bit games to use large address aware which can improve performance "
"and stability."
msgstr ""
"Memaksa game 32-bit menggunakan large address aware yang dapat meningkatkan "
"kinerja dan stabilitas."

#. Diagnostics & raw command
#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:37
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1328
msgid "Proton debug log"
msgstr "Log debug Proton"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:38
msgid ""
"Enables logging for Proton which can help with troubleshooting game issues. "
"Logs are saved in the game's compatibility data folder."
msgstr ""
"Mengaktifkan pencatatan untuk Proton yang dapat membantu memecahkan masalah "
"game. Log disimpan di folder data kompatibilitas game."

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:42
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1270
msgid "OptiScaler integration"
msgstr "Integrasi OptiScaler"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:43
msgid ""
"Enables the Proton OptiScaler which can improve performance and image "
"quality for some games (Available from version 11-1)."
msgstr ""
"Mengaktifkan OptiScaler Proton yang dapat meningkatkan kinerja dan kualitas "
"gambar untuk beberapa game (Tersedia sejak versi 11-1)."

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:47
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1271
msgid "Discord bridge"
msgstr "Jembatan Discord"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:48
msgid ""
"Enables the Proton Discord Bridge which can improve integration with Discord "
"for some games (Available from version 11-1)."
msgstr ""
"Mengaktifkan Jembatan Discord Proton yang dapat meningkatkan integrasi "
"dengan Discord untuk beberapa game (Tersedia sejak versi 11-1)."

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:52
msgid "Use D7VK"
msgstr "Gunakan D7VK"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:53
msgid ""
"Enables the use of D7VK which can improve performance and compatibility for "
"some Direct3D 9 games (Available from version 11-1)."
msgstr ""
"Mengaktifkan penggunaan D7VK yang dapat meningkatkan kinerja dan "
"kompatibilitas untuk beberapa game Direct3D 9 (Tersedia sejak versi 11-1)."

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:14
msgid "VKD3D options"
msgstr "Opsi VKD3D"

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:21
#: src/widgets/games/launch-options-editor/launch-options-editor-vkd3d-config.vala:65
msgid "Configure Direct3D 12 to Vulkan translation behavior"
msgstr "Konfigurasi perilaku terjemahan Direct3D 12 ke Vulkan"

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:27
#: src/widgets/games/launch-options-editor/launch-options-editor-vkd3d-log-level.vala:21
msgid "VKD3D Logging Level"
msgstr "Tingkat Pencatatan VKD3D"

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:30
msgid "Enable VKD3D GPUVA"
msgstr "Aktifkan VKD3D GPUVA"

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:31
msgid ""
"Enables GPU Virtual Addressing. Aligns Vulkan memory management with native "
"DX12 behavior to improve texture streaming and stability in open-world games."
msgstr ""
"Mengaktifkan Pengalamatan Virtual GPU. Menyelaraskan manajemen memori Vulkan "
"dengan perilaku DX12 native untuk meningkatkan streaming tekstur dan "
"stabilitas di game open-world."

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:36
msgid "Enable VKD3D Shader Cache"
msgstr "Aktifkan Cache Shader VKD3D"

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:37
msgid ""
"Enables VKD3D's internal shader caching mechanism to minimize in-game "
"stutter."
msgstr ""
"Mengaktifkan mekanisme caching shader internal VKD3D untuk meminimalkan "
"patah-patah dalam game."

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:41
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1281
msgid "Proton-CachyOS DX12 low latency"
msgstr "Proton-CachyOS DX12 latensi rendah"

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:42
msgid ""
"Uses Reflex markers or waitable swapchains. Intel GPUs and frame generation "
"are unsupported."
msgstr ""
"Menggunakan marker Reflex atau swapchain yang dapat ditunggu. GPU Intel dan "
"generasi frame tidak didukung."

#. Display & launch tools
#: src/widgets/games/launch-options-editor/groups/wrapper-group.vala:19
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1240
