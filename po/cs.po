msgstr "Tento nástroj kompatibility není správně nakonfigurován."

#: src/return_codes.vala:51
msgid "This operation is not supported for this compatibility tool."
msgstr "Tato operace není pro tento nástroj kompatibility podporována."

#: src/return_codes.vala:55
msgid "Unable to reach the API."
msgstr "Nelze se připojit k API."

#: src/return_codes.vala:57
msgid "API limit reached."
msgstr "Byl dosažen limit API."

#: src/return_codes.vala:59
msgid "Invalid access token."
msgstr "Neplatný přístupový token."

#: src/return_codes.vala:61
msgid "A secure connection could not be established."
msgstr "Nepodařilo se navázat zabezpečené připojení."

#: src/return_codes.vala:63
msgid "This archive format is not supported."
msgstr "Tento formát archivu není podporován."

#: src/return_codes.vala:65
msgid "The archive could not be extracted."
msgstr "Archiv nebylo možné rozbalit."

#: src/return_codes.vala:67
msgid "The selected variant is not compatible with this system."
msgstr "Vybraná varianta není s tímto systémem kompatibilní."

#: src/return_codes.vala:69
msgid ""
"A compatibility tool is currently in use. Close the running game and try "
"again."
msgstr ""
"Nástroj kompatibility se právě používá. Zavřete spuštěnou hru a zkuste to "
"znovu."

#: src/return_codes.vala:71
msgid ""
"Running compatibility tools could not be checked. Try again before changing "
"an installed tool."
msgstr ""
"Spuštěné nástroje kompatibility se nepodařilo zkontrolovat. Před změnou "
"nainstalovaného nástroje to zkuste znovu."

#: src/return_codes.vala:73
msgid "The operation could not be completed."
msgstr "Operaci nebylo možné dokončit."

#: src/services/installation-service.vala:457
msgid ""
"The compatibility tool changed, but the Steam restart reminder could not be "
"saved."
msgstr ""
"Nástroj kompatibility byl změněn, ale připomenutí restartu Steamu se "
"nepodařilo uložit."

