msgstr "Spustitelné (*.exe, *.msi, *.msu)"

#: src/widgets/games/games-row.vala:370
msgid "Compatibility Tool Not Found"
msgstr "Nástroj kompatibility nebyl nalezen"

#: src/widgets/games/games-row.vala:371
#, c-format
