msgstr "Automaticky aktualizovat nástroje na pozadí"

#: src/widgets/introduction/updates.vala:24
#: src/widgets/preferences/preferences-dialog.vala:99
msgid "Set how often to check for updates in the background"
msgstr "Nastavte, jak často se mají na pozadí kontrolovat aktualizace"

#: src/widgets/introduction/updates.vala:30
#: src/widgets/preferences/preferences-dialog.vala:105
