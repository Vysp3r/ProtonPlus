#: src/launch-options/launch-option-capability-resolver.vala:352
msgid ""
"The selected Proton build does not advertise legacy PROTON_ENABLE_HDR "
"support."
msgstr "Vybraný build Protonu neuvádí podporu staršího PROTON_ENABLE_HDR."

#: src/launch-options/launch-option-capability-resolver.vala:353
msgid ""
"The selected Proton build does not advertise automatic-HDR opt-out support."
msgstr "Vybraný build Protonu neuvádí podporu automatického vypnutí HDR."

#: src/launch-options/launch-option-capability-resolver.vala:354
msgid ""
"The selected Proton build does not advertise PROTON_FSR4_UPGRADE support."
msgstr "Vybraný build Protonu neuvádí podporu PROTON_FSR4_UPGRADE."

#: src/launch-options/launch-option-capability-resolver.vala:355
msgid ""
"The selected Proton build does not advertise the legacy RDNA3 FSR 4 switch."
msgstr "Vybraný build Protonu neuvádí starší přepínač RDNA3 FSR 4."

#: src/launch-options/launch-option-capability-resolver.vala:356
msgid ""
"The selected Proton build does not advertise PROTON_MLFG_UPGRADE support."
msgstr "Vybraný build Protonu neuvádí podporu PROTON_MLFG_UPGRADE."

#: src/launch-options/launch-option-capability-resolver.vala:357
msgid ""
"The selected Proton build does not advertise its DXVK low-latency option."
msgstr "Vybraný build Protonu neuvádí svou nízkolatenční možnost DXVK."

#: src/launch-options/launch-option-capability-resolver.vala:358
msgid ""
"The selected Proton build does not advertise its VKD3D-Proton low-latency "
"option."
msgstr "Vybraný build Protonu neuvádí svou nízkolatenční možnost VKD3D-Proton."

#: src/launch-options/launch-option-capability-resolver.vala:359
msgid ""
"The selected Proton build does not advertise the low-latency Vulkan layer."
msgstr "Vybraný build Protonu neuvádí nízkolatenční vrstvu Vulkanu."

#: src/launch-options/launch-option-capability-resolver.vala:360
msgid "The selected Proton build does not advertise its Vulkan Reflex layer."
msgstr "Vybraný build Protonu neuvádí svou vrstvu Vulkan Reflex."

