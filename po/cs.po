msgstr "🐛 Opraveno stahování Proton-GE RTSP"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:155
msgid "🐛 Fixed Proton-GE downloading wrong version"
msgstr "🐛 Opraveno stahování špatné verze Proton-GE"

#: data/com.vysp3r.ProtonPlus.metainfo.xml.in:156
msgid "🐛 Fixed yad check for Steam Tinker Launch"
msgstr "🐛 Opravena kontrola yad pro Steam Tinker Launch"

