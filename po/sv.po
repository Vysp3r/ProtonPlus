msgstr "Ett oväntat fel inträffade"

#: src/widgets/loading/loading-box.vala:83
msgid ""
"We encountered a problem while loading your application.\n"
"Please try again or report the problem."
msgstr ""
"Ett problem uppstod när ProtonPlus skulle läsas in.\n"
"Försök igen eller rapportera problemet."

#: src/widgets/loading/loading-box.vala:97
msgid "No game launcher found"
msgstr "Ingen spelstartare hittades"

#: src/widgets/loading/loading-box.vala:131
msgid "Open launcher website"
msgstr "Öppna spelstartarens webbplats"

#: src/widgets/loading/loading-box.vala:147
