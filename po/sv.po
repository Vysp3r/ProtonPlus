msgstr "Försök läsa in igen"

#: src/widgets/loading/loading-box.vala:152
msgid "Report issue"
msgstr "Rapportera problem"

#: src/widgets/loading/loading-box.vala:172
msgid "A supported launcher is required to get started."
msgstr "Du behöver en spelstartare som stöds för att komma igång."

#: src/widgets/loading/loading-box.vala:174
msgid "Open the launcher once, then check again."
msgstr "Öppna spelstartaren en gång och kontrollera sedan igen."

#: src/widgets/loading/loading-box.vala:178
msgid "Check again"
msgstr "Kontrollera igen"

#: src/widgets/loading/loading-box.vala:183
msgid "Supported launchers"
msgstr "Spelstartare som stöds"

#: src/widgets/loading/loading-box.vala:234
msgid "Already installed a launcher? Troubleshooting"
msgstr "Har du redan installerat en spelstartare? Se felsökningen"

