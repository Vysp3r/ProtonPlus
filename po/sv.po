#: src/launch-options/launch-option-catalog.vala:1325
msgid "Wine ALSA output channels"
msgstr "Utgångskanaler för ALSA i Wine"

#: src/launch-options/launch-option-catalog.vala:1325
msgid "Sets the Wine ALSA output channel count."
msgstr ""

#: src/launch-options/launch-option-catalog.vala:1326
msgid "Wine ALSA spatial downmix"
msgstr "Nedmixning av rumsligt ljud med ALSA i Wine"

#: src/launch-options/launch-option-catalog.vala:1326
msgid "Enables Wine ALSA spatial downmix for 4, 6, or 8 channels."
msgstr ""

#: src/launch-options/launch-option-catalog.vala:1326
msgid "Requires 4, 6, or 8 output channels"
msgstr ""

#. Game arguments
#: src/launch-options/launch-option-catalog.vala:1329
msgid "Skip launcher"
msgstr "Hoppa över spelstartaren"

#: src/launch-options/launch-option-catalog.vala:1329
msgid "Adds -skip-launcher for games that support it."
msgstr "Lägger till -skip-launcher för spel som stödjer det."

#: src/launch-options/launch-option-catalog.vala:1330
msgid "Vulkan renderer"
msgstr "Vulkan-renderare"

#: src/launch-options/launch-option-catalog.vala:1330
msgid "Adds -vulkan."
msgstr "Lägger till -vulkan."

#: src/launch-options/launch-option-catalog.vala:1331
msgid "DirectX 11 renderer"
msgstr "DirectX 11-renderare"

#: src/launch-options/launch-option-catalog.vala:1331
msgid "Adds -dx11."
msgstr "Lägger till -dx11."

#: src/launch-options/launch-option-catalog.vala:1332
msgid "DirectX 12 renderer"
msgstr "DirectX 12-renderare"

#: src/launch-options/launch-option-catalog.vala:1332
msgid "Adds -dx12."
msgstr "Lägger till -dx12."

#: src/launch-options/launch-option-catalog.vala:1333
msgid "Developer console"
msgstr "Utvecklarkonsol"

#: src/launch-options/launch-option-catalog.vala:1333
msgid "Adds -console when the game supports it."
msgstr "Lägger till -console när spelet stödjer det."

#: src/launch-options/launch-option-catalog.vala:1334
#: src/widgets/games/launch-options-editor/groups/advanced-options-group.vala:19
msgid "Custom game arguments"
msgstr "Egna spelargument"

#: src/launch-options/launch-option-catalog.vala:1334
msgid ""
"Adds individual custom arguments and preserves unrecognized launch options "
"exactly as loaded."
msgstr ""
"Lägger till individuella anpassade argument och bevarar okända "
"startalternativ exakt som de laddades."

#: src/launch-options/launch-option-catalog.vala:1335
msgid "Custom wrapper"
msgstr "Eget omslagsprogram"

#: src/launch-options/launch-option-catalog.vala:1335
msgid "Run an executable or script before the Steam game command."
msgstr "Kör ett program eller skript före Steams spelkommando."

#. Diagnostics & raw command
#: src/launch-options/launch-option-catalog.vala:1338
msgid "Proton debug log"
msgstr "Felsökningslogg för Proton"

#: src/launch-options/launch-option-catalog.vala:1338
msgid "Enables Proton troubleshooting logs."
msgstr ""

#: src/launch-options/launch-option-catalog.vala:1339
msgid "DXVK log level"
msgstr "Loggnivå för DXVK"

#: src/launch-options/launch-option-catalog.vala:1339
msgid "Controls DXVK logging."
msgstr "Styr DXVK loggning."

#: src/launch-options/launch-option-catalog.vala:1340
msgid "VKD3D log level"
msgstr "Loggnivå för VKD3D"

#: src/launch-options/launch-option-catalog.vala:1340
msgid "Controls VKD3D troubleshooting logs."
msgstr "Styr VKD3D-felsökningsloggar."

#: src/launch-options/launch-option-catalog.vala:1341
msgid "Steam command placeholder (%command%)"
msgstr "Platshållare för Steam-kommandot (%command%)"

#: src/launch-options/launch-option-catalog.vala:1341
msgid "Marks where Steam inserts the game's command."
msgstr "Anger var Steam infogar kommandot som startar spelet."

#: src/launch-options/launch-option-catalog.vala:1342
msgid "Preserved unrecognized launch options"
msgstr "Bevarade okända startalternativ"

#: src/launch-options/launch-option-catalog.vala:1342
msgid "Keeps unrecognized, quoted, and opaque shell content exactly as loaded."
msgstr ""
"Okänt innehåll, text inom citattecken och skaluttryck som inte kan tolkas "
"bevaras oförändrade."

#: src/launch-options/launch-option-flags.vala:18
msgid "Loads Vulkan validation layers and enables debug extensions."
msgstr "Läser in Vulkans valideringslager och aktiverar felsökningstillägg."

#: src/launch-options/launch-option-flags.vala:19
msgid "Turns off game-specific workarounds for debugging."
msgstr "Stänger av spelspecifika kompatibilitetslösningar vid felsökning."

#: src/launch-options/launch-option-flags.vala:20
msgid "Turns off DirectX Raytracing support."
msgstr "Stänger av stödet för DirectX Raytracing."

#: src/launch-options/launch-option-flags.vala:21
msgid "Forces DirectX Raytracing support even when considered unsafe."
msgstr ""
"Tvingar fram stöd för DirectX Raytracing även när det bedöms vara osäkert."

#: src/launch-options/launch-option-flags.vala:22
msgid ""
"Enables experimental DXR 1.2 support when opacity micromaps are available."
msgstr ""
"Aktiverar experimentellt stöd för DXR 1.2 när mikrokartor för opacitet är "
"tillgängliga."

#: src/launch-options/launch-option-flags.vala:23
msgid "Uses an unsafe constant-buffer optimization intended for NVIDIA GPUs."
msgstr ""
"Använder en osäker optimering av konstantbuffertar avsedd för "
"grafikprocessorer från NVIDIA."

#: src/launch-options/launch-option-flags.vala:24
msgid "Uses one queue instead of asynchronous compute and transfer queues."
msgstr ""
"Använder en enda kö i stället för asynkrona köer för beräkning och "
"överföring."

#: src/launch-options/launch-option-flags.vala:25
msgid ""
"Prevents upload heaps from using CPU-visible video memory. May reduce GPU "
"performance."
msgstr ""
"Hindrar uppladdningsheapar från att använda videominne som processorn kan "
"komma åt. Kan försämra grafikprestandan."

#: src/launch-options/launch-option-flags.vala:26
msgid "Uses cached memory for host-visible allocations to speed up captures."
msgstr ""
"Använder cachelagrat minne för allokeringar som värdsystemet kan komma åt, "
"så att bildfångsten går snabbare."

#: src/launch-options/launch-option-flags.vala:27
msgid "Turns off the invariant-position workaround."
msgstr "Stänger av lösningen för invarianta positioner."

#: src/launch-options/launch-option-flags.vala:28
msgid ""
"Lets the application manage pipeline caches instead of using the automatic "
"shader cache."
msgstr ""
"Låter programmet hantera pipelinecachar i stället för att använda den "
"automatiska shadercachen."

#: src/launch-options/launch-option-flags.vala:31
msgid "Uses 32-thread waves for compute shaders on GFX10 and newer GPUs."
msgstr ""
"Använder grupper om 32 trådar för beräkningsshaders på GFX10 och nyare "
"grafikprocessorer."

#: src/launch-options/launch-option-flags.vala:32
msgid "Enables Delta Color Compression for multisampled images."
msgstr "Aktiverar Delta Color Compression för multisamplade bilder."

#: src/launch-options/launch-option-flags.vala:33
msgid "Uploads shaders to video memory that the CPU cannot directly access."
msgstr "Läser in shaders i videominne som processorn inte kan komma åt direkt."

#: src/launch-options/launch-option-flags.vala:34
msgid ""
"Uses 32-thread waves for vertex, tessellation, and geometry shaders on GFX10 "
"and newer GPUs."
msgstr ""
"Använder grupper om 32 trådar för vertex-, tessellerings- och "
"geometrishaders på GFX10 och nyare grafikprocessorer."

#: src/launch-options/launch-option-flags.vala:35
msgid "Enables local buffer objects."
msgstr "Aktiverar lokala buffertobjekt."

#: src/launch-options/launch-option-flags.vala:36
msgid "Enables low-latency video decoding."
msgstr "Aktiverar videoavkodning med låg latens."

#: src/launch-options/launch-option-flags.vala:37
msgid "Enables low-latency video encoding."
msgstr "Aktiverar videokodning med låg latens."

#: src/launch-options/launch-option-flags.vala:38
msgid "Enables Next-Gen Geometry culling on GFX11 and newer GPUs."
msgstr ""
"Aktiverar bortgallring av geometri med Next-Gen Geometry på GFX11 och nyare "
"grafikprocessorer."

#: src/launch-options/launch-option-flags.vala:39
msgid ""
"Caches intermediate shader code for individual graphics pipeline stages."
msgstr "Cachelagrar mellanliggande shaderkod för varje steg i grafikpipelinen."

#: src/launch-options/launch-option-flags.vala:40
msgid ""
"Prevents memory allocations from spilling into system memory through GTT."
msgstr "Hindrar att minnesallokeringar flyttas över till systemminnet via GTT."

#: src/launch-options/launch-option-flags.vala:41
msgid ""
"Disables optimizations for systems whose entire video memory is CPU-visible."
msgstr ""
"Stänger av optimeringar för system där processorn har direkt åtkomst till "
"hela videominnet."

#: src/launch-options/launch-option-flags.vala:42
msgid "Uses 32-thread waves for pixel shaders on GFX10 and newer GPUs."
msgstr ""
"Använder grupper om 32 trådar för pixelshaders på GFX10 och nyare "
"grafikprocessorer."

#: src/launch-options/launch-option-flags.vala:43
msgid ""
"Uses continuation-passing lowering for ray tracing instead of function calls."
msgstr ""
"Kompilerar strålspårningen med explicita fortsättningar (continuation-"
"passing) i stället för funktionsanrop."

#: src/launch-options/launch-option-flags.vala:46
msgid "Detects GPU hangs and writes a diagnostic report."
msgstr ""
"Upptäcker när grafikprocessorn slutar svara och skriver en diagnostikrapport."

#: src/launch-options/launch-option-flags.vala:47
msgid "Synchronizes shader execution after every draw and dispatch."
msgstr "Synkroniserar shaderkörningen efter varje rit- och beräkningskommando."

#: src/launch-options/launch-option-flags.vala:48
msgid "Turns off shader caching."
msgstr "Stänger av cachelagring av shaders."

#: src/launch-options/launch-option-flags.vala:49
msgid "Turns off Delta Color Compression for images."
msgstr "Stänger av Delta Color Compression för bilder."

#: src/launch-options/launch-option-flags.vala:50
msgid "Turns off Vulkan graphics pipeline libraries."
msgstr "Stänger av Vulkans bibliotek för grafikpipelines."

#: src/launch-options/launch-option-flags.vala:51
msgid ""
"Reports pipeline cache hits and misses to inspect shader precompilation."
msgstr ""
"Rapporterar träffar och missar i pipelinecachen så att förkompileringen av "
"shaders kan granskas."

#: src/launch-options/launch-option-flags.vala:54
msgid ""
"Checks the shader compiler intermediate representation during compilation."
msgstr ""
"Kontrollerar shaderkompilatorns mellanrepresentation under kompileringen."

#: src/launch-options/launch-option-flags.vala:55
msgid "Prints information used to calculate pipeline statistics."
msgstr "Skriver ut information som används för att beräkna pipelinestatistik."

#: src/launch-options/launch-option-flags.vala:56
msgid ""
"Forces wait instructions whenever outstanding operations need to finish."
msgstr "Infogar väntinstruktioner när pågående operationer måste slutföras."

#: src/launch-options/launch-option-flags.vala:57
msgid "Turns off instruction scheduling for compiler debugging."
msgstr ""
"Stänger av schemaläggningen av instruktioner vid felsökning av kompilatorn."

#: src/launch-options/launch-option-shell-tokenizer.vala:34
#, c-format
msgid ""
"Enter one executable path, with quotes around spaces. You can include "
"%command% at the end."
msgstr ""
"Ange en enda sökväg till en körbar fil. Sätt sökvägen inom citattecken om "
"den innehåller blanksteg. Du kan lägga till %command% allra sist."

