#: src/models/runners/steamtinkerlaunch.vala:6
msgid ""
"Steam tool for easy, graphical configuration of your other compatibility "
"tools for both Windows games and native Linux games."
msgstr ""
"Strumento per Steam per una configurazione facile e grafica dei tuoi altri "
"strumenti di compatibilità sia per giochi Windows che per giochi nativi "
"Linux."

#: src/translatables.vala:4
msgid "Compatibility tools by Valve for running Windows software on Linux."
msgstr ""
"Strumenti di compatibilità di Valve per l'esecuzione di applicazioni Windows"
" su Linux."

#: src/translatables.vala:5
msgid ""
"Steam compatibility tool for running Windows games with improvements over "
"Valve's default Proton."
msgstr ""
"Strumento di compatibilità per Steam per l'esecuzione di giochi Windows con "
"miglioramenti rispetto a Proton predefinito di Valve."

#: src/translatables.vala:6
msgid ""
"Steam compatibility tool from the CachyOS Linux distribution for running "
"Windows games with improvements over Valve's default Proton."
msgstr ""
"Strumento di compatibilità per Steam della distribuzione Linux CachyOS per "
"l'esecuzione di giochi Windows con miglioramento rispetto a Proton "
"predefinito di Valve."

#: src/translatables.vala:7
msgid "Dawn Winery's custom Proton fork with fixes for various games :xdd:"
msgstr ""
"Fork personalizzato di Proton di Dawn Winery con correzioni per vari giochi "
":xdd:"

#: src/translatables.vala:8
msgid ""
"Steam compatibility tool for running Windows games with improvements over "
"Valve's default Proton. By Etaash Mathamsetty adding FSR4 support and wine "
"wayland tweaks."
msgstr ""
"Strumento di compatibilità per Steam per l'esecuzione di giochi Windows con "
"miglioramenti rispetto a Proton predefinito di Valve. Fatto da Etaash "
"Mathamsetty aggiungendo supporto a FSR4 e modifiche per wine wayland."

#: src/translatables.vala:9
msgid "Custom Proton build for running Windows games, based on Wine-tkg."
msgstr ""
"Versione di Proton personalizzata per l'esecuzione di giochi Windows, basata"
" su wine-tkg."

#: src/translatables.vala:10
msgid ""
"Steam compatibility tool based on Proton-GE with additional patches to "
"improve RTSP codecs for VRChat."
msgstr ""
"Strumento di compatibilità per Steam basato su Proton-GE con modifiche "
"aggiuntive per migliorare i codec RTSP per VRChat."

#: src/translatables.vala:11
msgid ""
"Luxtorpeda provides Linux-native game engines for certain Windows-only "
"games."
msgstr ""
"Luxtorpeda fornisce motori di gioco nativi Linux per specifici giochi "
"Windows."

#: src/translatables.vala:12
msgid ""
"Steam compatibility tool for running adventure games using ScummVM for "
"Linux."
msgstr ""
"Strumento di compatibilità per Steam per eseguire giochi di avventura "
"utilizzando ScummVM per Linux."

#: src/translatables.vala:13
msgid "Steam compatibility tool for running DOS games using DOSBox for Linux."
msgstr ""
"Strumento di compatibilità per Steam per eseguire giochi DOS utilizzando "
"DOSBox per Linux."

#: src/translatables.vala:14
msgid "Compatibility tools for running Windows software on Linux."
msgstr ""
"Strumenti di compatibilità per l'esecuzione di applicazioni Windows su "
"Linux."

#: src/translatables.vala:15
msgid "Wine build compiled from the official WineHQ sources."
msgstr "Versione di Wine compilata dalle fonti ufficiali WineHQ."

#: src/translatables.vala:16
msgid "Wine build with the Staging patchset."
msgstr "Versione di Wine con le modifiche di Staging applicate."

#: src/translatables.vala:17
msgid "Wine build with the Staging patchset and many other useful patches."
msgstr ""
"Versione di Wine con le modifiche di Staging applicate e molte altre "
"modifiche utili."

#: src/translatables.vala:18
msgid "Wine build modified by Valve and other contributors."
msgstr "Versione di Wine modificata da Valve e altri contributori."

#: src/translatables.vala:19
msgid ""
"Vulkan-based implementation of Direct3D 8, 9, 10 and 11 for Linux/Wine."
msgstr ""
"Implementazione basata su Vulkan di Direct3D 8, 9, 10 e 11 per Linux/Wine."

#: src/translatables.vala:20
msgid "DXVK builds that work with pre-Vulkan 1.3 versions."
msgstr ""
"Versioni di DXVK che funzionano con le versioni precedenti a Vulkan 1.3."

#: src/translatables.vala:21
msgid "DXVK Async builds that work with pre-Vulkan 1.3 versions."
msgstr ""
"Versioni di DXVK Async che funzionano con le versioni precedenti a Vulkan "
"1.3."

