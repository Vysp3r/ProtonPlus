msgstr "Traduttore DirectX basato su OpenGL interno di Wine"

#: src/widgets/games/launch-options-editor/launch-options-editor-dll-overrides.vala:52
msgid "Special D3D9 to OpenGL translation wrapper"
msgstr "Wrapper di traduzione speciale da D3D9 a OpenGL"

#: src/widgets/games/launch-options-editor/launch-options-editor-dll-overrides.vala:53
