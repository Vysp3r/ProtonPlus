msgstr "Nie udało się zapisać metadanych narzędzia zgodności"

#: src/services/standard-archive-workflow.vala:358
msgid "Failed to update compatibilitytool.vdf"
msgstr "Nie udało się zaktualizować compatibilitytool.vdf"

#: src/services/standard-archive-workflow.vala:375
msgid "The compatibility tool manifest is invalid or incomplete"
msgstr "Manifest narzędzia zgodności jest nieprawidłowy lub niekompletny"

#: src/services/steam-tinker-launch-workflow.vala:71
msgid "The SteamTinkerLaunch archive is invalid or incomplete"
msgstr "Archiwum SteamTinkerLaunch jest nieprawidłowe lub niekompletne"

#: src/services/steam-tinker-launch-workflow.vala:79
msgid "Failed to prepare the SteamTinkerLaunch executable"
