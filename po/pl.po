#, c-format
msgid "Use GPU-specific compatibility toggles for %s hardware."
msgstr "Przełączniki zgodności specyficzne dla kart %s."

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:19
msgid "More options"
msgstr "Więcej opcji"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:22
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1256
msgid "vkBasalt visual effects"
msgstr "Efekty wizualne vkBasalt"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:22
msgid "Adds visual effects like sharpening and color adjustments."
msgstr "Dodaje efekty wizualne, takie jak wyostrzanie i korekta kolorów."

#. Proton & Wine compatibility
#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:24
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1275
msgid "OpenGL fallback (WineD3D)"
msgstr "Awaryjny OpenGL (WineD3D)"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:25
msgid ""
"Uses OpenGL instead of Vulkan. Only enable if you're having DXVK issues."
msgstr "Używa OpenGL zamiast Vulkana. Włączaj tylko przy problemach z DXVK."

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:30
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1277
msgid "NTSync mode"
msgstr "Tryb NTSync"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:31
msgid ""
"Uses FSync instead of NTSync. Can fix issues in certain games that do not "
"pair well with NTSync."
msgstr ""
"Używa FSync zamiast NTSync. Może naprawić problemy w grach, które źle "
"współpracują z NTSync."

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:36
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1250
msgid "Per-game shader cache"
msgstr "Osobna pamięć podręczna shaderów dla gry"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:37
msgid ""
"Enables per-game shader cache. This isolates the shader cache of each game "
"but does not compile them ahead-of-time."
msgstr ""
"Włącza osobną pamięć podręczną shaderów dla każdej gry. Oddziela je od "
"siebie, ale nie kompiluje z wyprzedzeniem."

#. Input & audio
#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:41
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1326
msgid "Prefer SDL controller input"
msgstr "Preferuj wejście kontrolera przez SDL"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:41
msgid "Workaround for controller detection issues."
msgstr "Obejście problemów z wykrywaniem kontrolera."

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:43
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1327
msgid "Bypass Steam Input"
msgstr "Pomiń Steam Input"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:44
msgid "Disables Steam Input support. Fixes Wayland controller/gamepad issues."
msgstr ""
"Wyłącza obsługę Steam Input. Naprawia problemy z kontrolerami na Waylandzie."

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:48
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1281
msgid "Vulkan synchronization 2"
msgstr "Synchronizacja Vulkan 2"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:49
msgid ""
"Enables WINE_VK_USE_SYNC2 which can improve performance and reduce "
"stuttering in some games when using WineD3D."
msgstr ""
"Włącza WINE_VK_USE_SYNC2, co przy WineD3D może w części gier poprawić "
"wydajność i ograniczyć przycięcia."

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:53
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1282
msgid "Futex waitv synchronization"
msgstr "Synchronizacja przez futex waitv"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:54
msgid ""
"Enables WINE_SYNC_USE_FUTEX_WAITV which can improve performance and reduce "
"stuttering in some games when using WineD3D."
msgstr ""
"Włącza WINE_SYNC_USE_FUTEX_WAITV, co przy WineD3D może w części gier "
"poprawić wydajność i ograniczyć przycięcia."

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:58
msgid "Simulate Write-Copy Memory"
msgstr "Symuluj pamięć write-copy"

#: src/widgets/games/launch-options-editor/groups/more-options-group.vala:59
msgid ""
"Forces Wine to simulate page-write protection, fixing initialization errors "
"in certain older titles."
msgstr ""
"Wymusza w Wine symulację ochrony zapisu stron, naprawiając błędy "
"inicjalizacji w części starszych gier."

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:18
msgid "Proton options"
msgstr "Opcje Protona"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:19
msgid "Extra Proton settings and launch behaviors."
msgstr "Dodatkowe ustawienia Protona i zachowania przy uruchamianiu."

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:22
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1249
msgid "High process priority"
msgstr "Wysoki priorytet procesu"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:23
msgid ""
"Gives the game a higher CPU priority which can improve performance in some "
"cases."
msgstr ""
"Nadaje grze wyższy priorytet procesora, co w niektórych przypadkach poprawia "
"wydajność."

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:27
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1279
msgid "WoW64 mode"
msgstr "Tryb WoW64"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:28
msgid ""
"Enables WoW64 support for 32-bit games on 64-bit Proton builds. This can "
"improve compatibility for some older games."
msgstr ""
"Włącza obsługę WoW64 dla gier 32-bitowych w 64-bitowych kompilacjach "
"Protona. Może to poprawić zgodność części starszych gier."

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:32
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1278
msgid "Large address awareness for 32-bit games"
msgstr "Obsługa dużych adresów w grach 32-bitowych"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:33
msgid ""
"Forces 32-bit games to use large address aware which can improve performance "
"and stability."
msgstr ""
"Wymusza w grach 32-bitowych tryb dużych adresów, co może poprawić wydajność "
"i stabilność."

#. Diagnostics & raw command
#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:37
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1341
msgid "Proton debug log"
msgstr "Dziennik diagnostyczny Protona"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:38
msgid ""
"Enables logging for Proton which can help with troubleshooting game issues. "
"Logs are saved in the game's compatibility data folder."
msgstr ""
"Włącza rejestrowanie zdarzeń Protona, pomocne przy diagnozowaniu problemów z "
"grami. Dzienniki trafiają do katalogu danych zgodności gry."

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:42
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1283
msgid "OptiScaler integration"
msgstr "Integracja z OptiScalerem"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:43
msgid ""
"Enables the Proton OptiScaler which can improve performance and image "
"quality for some games (Available from version 11-1)."
msgstr ""
"Włącza OptiScaler w Protonie, co w części gier poprawia wydajność i jakość "
"obrazu (dostępne od wersji 11-1)."

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:47
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1284
msgid "Discord bridge"
msgstr "Mostek Discorda"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:48
msgid ""
"Enables the Proton Discord Bridge which can improve integration with Discord "
"for some games (Available from version 11-1)."
msgstr ""
"Włącza mostek Discorda w Protonie, poprawiający integrację z Discordem w "
"części gier (dostępne od wersji 11-1)."

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:52
msgid "Use D7VK"
msgstr "Użyj D7VK"

#: src/widgets/games/launch-options-editor/groups/proton-options-group.vala:53
msgid ""
"Enables the use of D7VK which can improve performance and compatibility for "
"some Direct3D 9 games (Available from version 11-1)."
msgstr ""
"Włącza D7VK, co w części gier na Direct3D 9 poprawia wydajność i zgodność "
"(dostępne od wersji 11-1)."

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:14
msgid "VKD3D options"
msgstr "Opcje VKD3D"

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:21
#: src/widgets/games/launch-options-editor/launch-options-editor-vkd3d-config.vala:18
msgid "Configure Direct3D 12 to Vulkan translation behavior"
msgstr "Konfiguracja tłumaczenia Direct3D 12 na Vulkana"

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:27
#: src/widgets/games/launch-options-editor/launch-options-editor-vkd3d-log-level.vala:21
msgid "VKD3D Logging Level"
msgstr "Poziom rejestrowania VKD3D"

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:30
msgid "Enable VKD3D GPUVA"
msgstr "Włącz VKD3D GPUVA"

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:31
msgid ""
"Enables GPU Virtual Addressing. Aligns Vulkan memory management with native "
"DX12 behavior to improve texture streaming and stability in open-world games."
msgstr ""
"Włącza adresowanie wirtualne GPU. Upodabnia zarządzanie pamięcią Vulkana do "
"natywnego zachowania DX12, poprawiając strumieniowanie tekstur i stabilność "
"w grach z otwartym światem."

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:36
msgid "Enable VKD3D Shader Cache"
msgstr "Włącz pamięć podręczną shaderów VKD3D"

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:37
msgid ""
"Enables VKD3D's internal shader caching mechanism to minimize in-game "
"stutter."
msgstr ""
"Włącza wewnętrzny mechanizm pamięci podręcznej shaderów VKD3D, ograniczający "
"przycięcia w grze."

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:41
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1294
msgid "Proton-CachyOS DX12 low latency"
msgstr "Niskie opóźnienia DX12 w Proton-CachyOS"

#: src/widgets/games/launch-options-editor/groups/vkd3d-options-group.vala:42
msgid ""
"Uses Reflex markers or waitable swapchains. Intel GPUs and frame generation "
"are unsupported."
msgstr ""
"Używa znaczników Reflex lub oczekiwalnych łańcuchów wymiany. Karty Intel i "
"generowanie klatek nie są obsługiwane."

#. Display & launch tools
#: src/widgets/games/launch-options-editor/groups/wrapper-group.vala:19
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1253
msgid "Launch backend"
msgstr "Backend uruchamiania"

#: src/widgets/games/launch-options-editor/groups/wrapper-group.vala:20
msgid ""
"Choose System default, Gamescope, or ScopeBuddy for display and launch "
"options."
msgstr ""
"Wybierz domyślny systemowy, Gamescope lub ScopeBuddy dla opcji wyświetlania "
"i uruchamiania."

#: src/widgets/games/launch-options-editor/groups/wrapper-group.vala:46
msgid "System default"
msgstr "Domyślny systemowy"

#: src/widgets/games/launch-options-editor/groups/wrapper-group.vala:49
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1261
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1262
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1263
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1264
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1265
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1266
#: src/widgets/preferences/preferences-dialog.vala:395
msgid "Gamescope"
msgstr "Gamescope"

#: src/widgets/games/launch-options-editor/groups/wrapper-group.vala:54
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1267
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1268
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1269
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1270
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1271
#: src/widgets/games/launch-options-editor/launch-options-option-catalog.vala:1272
#: src/widgets/preferences/preferences-dialog.vala:398
msgid "ScopeBuddy"
msgstr "ScopeBuddy"

#: src/widgets/games/launch-options-editor/launch-option-capability-resolver.vala:214
msgid "This option is unsupported and cannot be newly enabled."
msgstr "Ta opcja nie jest obsługiwana i nie można jej teraz włączyć."

#: src/widgets/games/launch-options-editor/launch-option-capability-resolver.vala:221
msgid "This legacy option is preserved but cannot be newly enabled."
msgstr "Ta przestarzała opcja jest zachowana, ale nie można jej teraz włączyć."

#: src/widgets/games/launch-options-editor/launch-option-capability-resolver.vala:225
msgid "Compatibility-tool capabilities are not known yet."
msgstr "Możliwości narzędzia zgodności nie są jeszcze znane."

#: src/widgets/games/launch-options-editor/launch-option-capability-resolver.vala:242
msgid "Requires an available launch backend."
msgstr "Wymaga dostępnego backendu uruchamiania."

#: src/widgets/games/launch-options-editor/launch-option-capability-resolver.vala:250
msgid "Requires a compatible Proton variant."
msgstr "Wymaga zgodnego wariantu Protona."

#: src/widgets/games/launch-options-editor/launch-option-capability-resolver.vala:267
msgid "The selected launch backend is not supported."
msgstr "Wybrany backend uruchamiania nie jest obsługiwany."

#: src/widgets/games/launch-options-editor/launch-option-capability-resolver.vala:345
msgid "Requires an AMD GPU."
msgstr "Wymaga karty AMD."

#: src/widgets/games/launch-options-editor/launch-option-capability-resolver.vala:346
msgid "Requires an NVIDIA GPU."
msgstr "Wymaga karty NVIDIA."

#: src/widgets/games/launch-options-editor/launch-option-capability-resolver.vala:347
msgid "Requires an Intel GPU."
msgstr "Wymaga karty Intel."

#: src/widgets/games/launch-options-editor/launch-option-capability-resolver.vala:348
msgid "Requires MangoHud, which is not available."
msgstr "Wymaga MangoHud, który jest niedostępny."

#: src/widgets/games/launch-options-editor/launch-option-capability-resolver.vala:349
msgid "Requires GameMode, which is not available."
msgstr "Wymaga GameMode, który jest niedostępny."

#: src/widgets/games/launch-options-editor/launch-option-capability-resolver.vala:350
msgid "Requires the CachyOS game-performance command, which is not available."
msgstr "Wymaga polecenia game-performance z CachyOS, które jest niedostępne."

#: src/widgets/games/launch-options-editor/launch-option-capability-resolver.vala:351
msgid "Requires obs-vkcapture, which is not available."
msgstr "Wymaga obs-vkcapture, które jest niedostępny."

#: src/widgets/games/launch-options-editor/launch-option-capability-resolver.vala:352
msgid "Requires Gamescope, which is not available."
msgstr "Wymaga Gamescope, który jest niedostępny."

