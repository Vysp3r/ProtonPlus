msgstr "Wymaga Gamescope"

#: src/launch-options/launch-option-catalog.vala:1258
#: src/launch-options/launch-option-catalog.vala:1264
msgid "Output resolution"
msgstr "Rozdzielczość wyjściowa"

#: src/launch-options/launch-option-catalog.vala:1258
#: src/widgets/games/launch-options-editor/wrappers/gamescope.vala:47
msgid "Sets the Gamescope output resolution."
msgstr "Ustawia rozdzielczość wyjściową Gamescope."

#: src/launch-options/launch-option-catalog.vala:1259
msgid "HDR"
msgstr "HDR"

#: src/launch-options/launch-option-catalog.vala:1259
msgid "Outputs HDR colors through Gamescope."
msgstr "Wyprowadza kolory HDR przez Gamescope."

#: src/launch-options/launch-option-catalog.vala:1260
msgid "Variable refresh rate"
msgstr "Zmienna częstotliwość odświeżania"

#: src/launch-options/launch-option-catalog.vala:1260
#: src/launch-options/launch-option-catalog.vala:1266
msgid "Matches the display refresh rate to the game's FPS."
msgstr "Dopasowuje częstotliwość odświeżania ekranu do liczby klatek w grze."

#: src/launch-options/launch-option-catalog.vala:1261
#: src/launch-options/launch-option-catalog.vala:1267
#: src/widgets/games/launch-options-editor/wrappers/gamescope.vala:43
#: src/widgets/games/launch-options-editor/wrappers/scopebuddy.vala:54
msgid "Frame limit"
msgstr "Limit klatek"

#: src/launch-options/launch-option-catalog.vala:1261
#: src/widgets/games/launch-options-editor/wrappers/gamescope.vala:43
msgid "Caps the frame rate inside Gamescope."
msgstr "Ogranicza liczbę klatek wewnątrz Gamescope."

#: src/launch-options/launch-option-catalog.vala:1262
#: src/widgets/games/launch-options-editor/wrappers/gamescope.vala:61
msgid "Additional Gamescope arguments"
msgstr "Dodatkowe argumenty Gamescope"

#: src/launch-options/launch-option-catalog.vala:1262
msgid "Keeps extra Gamescope flags such as output selection."
msgstr "Przechowuje dodatkowe flagi Gamescope, na przykład wybór wyjścia."

#: src/launch-options/launch-option-catalog.vala:1263
msgid "Runs the game in a fullscreen ScopeBuddy session."
msgstr "Uruchamia grę w pełnoekranowej sesji ScopeBuddy."

#: src/launch-options/launch-option-catalog.vala:1263
#: src/launch-options/launch-option-catalog.vala:1264
#: src/launch-options/launch-option-catalog.vala:1265
#: src/launch-options/launch-option-catalog.vala:1266
#: src/launch-options/launch-option-catalog.vala:1267
#: src/launch-options/launch-option-catalog.vala:1268
#: src/widgets/games/launch-options-editor/groups/wrapper-group.vala:56
#: src/widgets/preferences/preferences-dialog.vala:458
msgid "ScopeBuddy"
msgstr "ScopeBuddy"

#: src/launch-options/launch-option-catalog.vala:1263
#: src/launch-options/launch-option-catalog.vala:1264
#: src/launch-options/launch-option-catalog.vala:1265
#: src/launch-options/launch-option-catalog.vala:1266
#: src/launch-options/launch-option-catalog.vala:1267
#: src/launch-options/launch-option-catalog.vala:1268
msgid "Requires ScopeBuddy"
msgstr "Wymaga ScopeBuddy"

#: src/launch-options/launch-option-catalog.vala:1264
#: src/widgets/games/launch-options-editor/wrappers/scopebuddy.vala:61
msgid "Sets the ScopeBuddy output resolution."
msgstr "Ustawia rozdzielczość wyjściową ScopeBuddy."

#: src/launch-options/launch-option-catalog.vala:1265
msgid "Automatic HDR"
msgstr "Automatyczny HDR"

#: src/launch-options/launch-option-catalog.vala:1265
msgid "Enables HDR automatically when the display supports it."
msgstr "Włącza HDR automatycznie, gdy ekran to obsługuje."

#: src/launch-options/launch-option-catalog.vala:1266
msgid "Automatic variable refresh rate"
msgstr "Automatyczna zmienna częstotliwość odświeżania"

#: src/launch-options/launch-option-catalog.vala:1267
#: src/widgets/games/launch-options-editor/wrappers/scopebuddy.vala:54
msgid "Caps the frame rate inside ScopeBuddy."
msgstr "Ogranicza liczbę klatek wewnątrz ScopeBuddy."

#: src/launch-options/launch-option-catalog.vala:1268
#: src/widgets/games/launch-options-editor/wrappers/scopebuddy.vala:66
msgid "Additional ScopeBuddy arguments"
msgstr "Dodatkowe argumenty ScopeBuddy"

#: src/launch-options/launch-option-catalog.vala:1268
#: src/widgets/games/launch-options-editor/wrappers/scopebuddy.vala:67
msgid "Keeps extra ScopeBuddy flags such as preferred output selection."
msgstr ""
"Przechowuje dodatkowe flagi ScopeBuddy, na przykład wybór preferowanego "
"wyjścia."

#. Proton & Wine compatibility
#: src/launch-options/launch-option-catalog.vala:1271
msgid "OpenGL fallback (WineD3D)"
msgstr "Awaryjny OpenGL (WineD3D)"

#: src/launch-options/launch-option-catalog.vala:1271
msgid "Uses OpenGL instead of Vulkan when DXVK causes problems."
msgstr "Używa OpenGL zamiast Vulkana, gdy DXVK sprawia problemy."

#: src/launch-options/launch-option-catalog.vala:1272
msgid "D7VK for older Direct3D games"
msgstr "D7VK dla starszych gier Direct3D"

#: src/launch-options/launch-option-catalog.vala:1272
msgid "Enables D7VK for older Direct3D games."
msgstr "Włącza D7VK dla starszych gier Direct3D."

#: src/launch-options/launch-option-catalog.vala:1272
msgid "Requires a compatible Proton version"
msgstr "Wymaga zgodnej wersji Protona"

#: src/launch-options/launch-option-catalog.vala:1273
msgid "NTSync mode"
msgstr "Tryb NTSync"

#: src/launch-options/launch-option-catalog.vala:1273
msgid ""
"Uses FSync instead of NTSync for games that need that compatibility mode."
msgstr ""
"Używa FSync zamiast NTSync w grach, które potrzebują tego trybu zgodności."

#: src/launch-options/launch-option-catalog.vala:1274
msgid "Large address awareness for 32-bit games"
msgstr "Obsługa dużych adresów w grach 32-bitowych"

#: src/launch-options/launch-option-catalog.vala:1274
msgid "Lets supported 32-bit games use more than 2GB of memory."
msgstr "Pozwala obsługiwanym grom 32-bitowym użyć więcej niż 2 GB pamięci."

#: src/launch-options/launch-option-catalog.vala:1275
msgid "WoW64 mode"
msgstr "Tryb WoW64"

#: src/launch-options/launch-option-catalog.vala:1275
msgid "Enables WoW64 support for 32-bit games on 64-bit Proton builds."
msgstr ""
"Włącza obsługę WoW64 dla gier 32-bitowych w 64-bitowych kompilacjach Protona."

#: src/launch-options/launch-option-catalog.vala:1276
msgid "Write-copy memory workaround"
msgstr "Obejście dla pamięci write-copy"

#: src/launch-options/launch-option-catalog.vala:1276
msgid "Simulates page write protection for initialization errors."
msgstr "Symuluje ochronę zapisu stron przy błędach inicjalizacji."

#: src/launch-options/launch-option-catalog.vala:1277
msgid "Vulkan synchronization 2"
msgstr "Synchronizacja Vulkan 2"

#: src/launch-options/launch-option-catalog.vala:1277
msgid "Enables WINE_VK_USE_SYNC2."
msgstr "Włącza WINE_VK_USE_SYNC2."

#: src/launch-options/launch-option-catalog.vala:1278
msgid "Futex waitv synchronization"
msgstr "Synchronizacja przez futex waitv"

#: src/launch-options/launch-option-catalog.vala:1278
msgid "Enables WINE_SYNC_USE_FUTEX_WAITV."
msgstr "Włącza WINE_SYNC_USE_FUTEX_WAITV."

#: src/launch-options/launch-option-catalog.vala:1279
msgid "OptiScaler integration"
msgstr "Integracja z OptiScalerem"

#: src/launch-options/launch-option-catalog.vala:1279
msgid "Enables Proton OptiScaler."
msgstr "Włącza OptiScaler w Protonie."

#: src/launch-options/launch-option-catalog.vala:1279
#: src/launch-options/launch-option-catalog.vala:1280
#: src/launch-options/launch-option-catalog.vala:1325
msgid "Requires Proton 11-1 or newer"
msgstr "Wymaga Protona 11-1 lub nowszego"

#: src/launch-options/launch-option-catalog.vala:1280
msgid "Discord bridge"
msgstr "Mostek Discorda"

#: src/launch-options/launch-option-catalog.vala:1280
msgid "Enables Proton's Discord bridge."
msgstr "Włącza mostek Discorda w Protonie."

#: src/launch-options/launch-option-catalog.vala:1281
msgid "Wine DLL overrides"
msgstr "Podmiany bibliotek DLL w Wine"

#: src/launch-options/launch-option-catalog.vala:1281
msgid "Choose builtin or native Windows DLL behavior."
msgstr "Wybierz zachowanie bibliotek DLL: wbudowane czy natywne z Windows."

#. Graphics translation
#: src/launch-options/launch-option-catalog.vala:1284
#: src/widgets/games/launch-options-editor/groups/dxvk-options-group.vala:26
msgid "DXVK frame limit"
msgstr "Limit klatek DXVK"

#: src/launch-options/launch-option-catalog.vala:1284
msgid "Caps the frame rate with DXVK's built-in limiter."
msgstr "Ogranicza liczbę klatek wbudowanym ogranicznikiem DXVK."

#: src/launch-options/launch-option-catalog.vala:1284
#: src/launch-options/launch-option-catalog.vala:1285
msgid "DXVK"
msgstr "DXVK"

#: src/launch-options/launch-option-catalog.vala:1285
msgid "Asynchronous pipeline compilation"
msgstr "Asynchroniczna kompilacja potoków"

#: src/launch-options/launch-option-catalog.vala:1285
msgid "Enables DXVK asynchronous pipeline compilation."
msgstr "Włącza asynchroniczną kompilację potoków w DXVK."

#: src/launch-options/launch-option-catalog.vala:1285
msgid "Requires compatible patched DXVK"
msgstr "Wymaga zgodnego, załatanego DXVK"

#: src/launch-options/launch-option-catalog.vala:1286
msgid "VKD3D shader cache"
msgstr "Pamięć podręczna shaderów VKD3D"

#: src/launch-options/launch-option-catalog.vala:1286
msgid "Enables VKD3D's internal shader cache."
msgstr "Włącza wewnętrzną pamięć podręczną shaderów VKD3D."

#: src/launch-options/launch-option-catalog.vala:1286
#: src/launch-options/launch-option-catalog.vala:1287
#: src/launch-options/launch-option-catalog.vala:1288
msgid "VKD3D-Proton"
msgstr "VKD3D-Proton"

#: src/launch-options/launch-option-catalog.vala:1287
msgid "VKD3D GPU virtual addressing"
msgstr "Adresowanie wirtualne GPU w VKD3D"

#: src/launch-options/launch-option-catalog.vala:1287
msgid "Enables VKD3D GPU virtual addressing."
msgstr "Włącza adresowanie wirtualne GPU w VKD3D."

#: src/launch-options/launch-option-catalog.vala:1288
msgid "VKD3D compatibility settings"
msgstr "Ustawienia zgodności VKD3D"

#: src/launch-options/launch-option-catalog.vala:1288
msgid "Configure Direct3D 12 to Vulkan compatibility workarounds."
msgstr "Konfiguracja obejść zgodności przy tłumaczeniu Direct3D 12 na Vulkana."

#: src/launch-options/launch-option-catalog.vala:1289
msgid "Proton-CachyOS DX11 low latency"
msgstr "Niskie opóźnienia DX11 w Proton-CachyOS"

#: src/launch-options/launch-option-catalog.vala:1289
msgid ""
"Enables the Proton-CachyOS DXVK low-latency path for Direct3D 9–11. Requires "
"a selected custom Proton build that advertises this option."
msgstr ""
"Włącza ścieżkę niskich opóźnień DXVK z Proton-CachyOS dla Direct3D 9–11. "
"Wymaga wybranej własnej kompilacji Protona, która zgłasza tę opcję."

#: src/launch-options/launch-option-catalog.vala:1289
#: src/launch-options/launch-option-catalog.vala:1290
#: src/launch-options/launch-option-catalog.vala:1291
#: src/launch-options/launch-option-catalog.vala:1292
#: src/launch-options/launch-option-catalog.vala:1293
msgid "Proton-CachyOS"
msgstr "Proton-CachyOS"

#: src/launch-options/launch-option-catalog.vala:1289
msgid "Requires a compatible Proton-CachyOS build"
msgstr "Wymaga zgodnej kompilacji Proton-CachyOS"

#: src/launch-options/launch-option-catalog.vala:1290
msgid "Proton-CachyOS DX12 low latency"
msgstr "Niskie opóźnienia DX12 w Proton-CachyOS"

#: src/launch-options/launch-option-catalog.vala:1290
msgid ""
"Enables hardware-agnostic VKD3D-Proton low latency for Direct3D 12 games "
"that use Reflex markers or waitable swapchains. Intel GPUs, frame "
"generation, and games without markers are unsupported."
msgstr ""
"Włącza niezależne od sprzętu niskie opóźnienia VKD3D-Proton w grach Direct3D "
"12 korzystających ze znaczników Reflex lub oczekiwalnych łańcuchów wymiany. "
"Karty Intel, generowanie klatek i gry bez znaczników nie są obsługiwane."

#: src/launch-options/launch-option-catalog.vala:1290
msgid ""
"Requires a compatible Proton-CachyOS build; not compatible with frame "
"generation"
msgstr ""
"Wymaga zgodnej kompilacji Proton-CachyOS; nie działa z generowaniem klatek"

#: src/launch-options/launch-option-catalog.vala:1291
msgid "Proton-CachyOS Vulkan Anti-Lag 2 layer"
msgstr "Warstwa Vulkan Anti-Lag 2 w Proton-CachyOS"

#: src/launch-options/launch-option-catalog.vala:1291
msgid ""
"Enables the low-latency Vulkan layer with VK_AMD_anti_lag exposure. The game "
"must support AMD Anti-Lag 2; this does not add latency markers to "
"unsupported games."
msgstr ""
"Włącza warstwę Vulkan o niskich opóźnieniach z udostępnieniem "
"VK_AMD_anti_lag. Gra musi obsługiwać AMD Anti-Lag 2; w grach bez tej obsługi "
"znaczniki opóźnień nie zostaną dodane."

#: src/launch-options/launch-option-catalog.vala:1291
msgid ""
"Requires a compatible Proton-CachyOS build and game support for Anti-Lag 2"
msgstr ""
"Wymaga zgodnej kompilacji Proton-CachyOS i obsługi Anti-Lag 2 przez grę"

#: src/launch-options/launch-option-catalog.vala:1292
msgid "Expose Vulkan Reflex instead of Anti-Lag 2"
msgstr "Udostępnij Vulkan Reflex zamiast Anti-Lag 2"

#: src/launch-options/launch-option-catalog.vala:1292
msgid ""
"Switches the Proton-CachyOS low-latency Vulkan layer from VK_AMD_anti_lag to "
"VK_NV_low_latency2. Enable only for games with Vulkan Reflex support."
msgstr ""
"Przełącza warstwę Vulkan o niskich opóźnieniach z Proton-CachyOS z "
"VK_AMD_anti_lag na VK_NV_low_latency2. Włączaj tylko w grach z obsługą "
"Vulkan Reflex."

#: src/launch-options/launch-option-catalog.vala:1292
msgid "Requires the Vulkan low-latency layer"
msgstr "Wymaga warstwy Vulkan o niskich opóźnieniach"

#: src/launch-options/launch-option-catalog.vala:1293
msgid "Proton-CachyOS NVIDIA Reflex Vulkan layer"
msgstr "Warstwa Vulkan NVIDIA Reflex w Proton-CachyOS"

#: src/launch-options/launch-option-catalog.vala:1293
msgid ""
"Enables Proton-CachyOS's NVIDIA Reflex layer for native Vulkan games. The "
"game must already support VK_NV_low_latency2."
msgstr ""
"Włącza warstwę NVIDIA Reflex z Proton-CachyOS w natywnych grach Vulkan. Gra "
"musi już obsługiwać VK_NV_low_latency2."

#: src/launch-options/launch-option-catalog.vala:1293
msgid "Requires NVIDIA and a compatible Proton-CachyOS build"
msgstr "Wymaga karty NVIDIA i zgodnej kompilacji Proton-CachyOS"

#. Hardware & drivers
#: src/launch-options/launch-option-catalog.vala:1296
msgid "Use discrete GPU"
msgstr "Użyj karty dedykowanej"

#: src/launch-options/launch-option-catalog.vala:1296
msgid "Uses the AMD discrete GPU on hybrid systems."
msgstr "Korzysta z dedykowanej karty AMD w systemach hybrydowych."

#: src/launch-options/launch-option-catalog.vala:1296
#: src/launch-options/launch-option-catalog.vala:1297
#: src/launch-options/launch-option-catalog.vala:1298
#: src/launch-options/launch-option-catalog.vala:1299
#: src/launch-options/launch-option-catalog.vala:1300
#: src/launch-options/launch-option-catalog.vala:1301
#: src/launch-options/launch-option-catalog.vala:1306
#: src/launch-options/launch-option-catalog.vala:1307
#: src/launch-options/launch-option-catalog.vala:1308
#: src/launch-options/launch-option-catalog.vala:1309
#: src/launch-options/launch-option-catalog.vala:1310
#: src/launch-options/launch-option-catalog.vala:1311
#: src/launch-options/launch-option-catalog.vala:1312
#: src/launch-options/launch-option-catalog.vala:1313
#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:55
#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:71
msgid "AMD"
msgstr "AMD"

#: src/launch-options/launch-option-catalog.vala:1297
msgid "Mesa Anti-Lag"
msgstr "Mesa Anti-Lag"

#: src/launch-options/launch-option-catalog.vala:1297
msgid "Reduces latency on supported AMD Mesa setups."
msgstr "Zmniejsza opóźnienia w obsługiwanych konfiguracjach AMD z Mesa."

#: src/launch-options/launch-option-catalog.vala:1298
msgid "FSR 4 upgrade (current path)"
msgstr "Aktualizacja do FSR 4 (ścieżka bieżąca)"

#: src/launch-options/launch-option-catalog.vala:1298
msgid ""
"Upgrades supported FSR 3.1 games through the selected custom Proton build. "
"Value 1 selects that build's default FSR 4 release; supported builds also "
"accept a documented version. Proton-EM documents Mesa 25.2 for RDNA3/RDNA4, "
"while older RDNA generations use a slower compatibility layer. Current "
"Proton-GE disables Anti-Lag 2 while this is active."
msgstr ""
"Podnosi obsługiwane gry z FSR 3.1 przez wybraną własną kompilację Protona. "
"Wartość 1 wybiera domyślne wydanie FSR 4 z tej kompilacji; obsługiwane "
"kompilacje przyjmują też udokumentowaną wersję. Proton-EM podaje Mesa 25.2 "
"dla RDNA3/RDNA4, a starsze generacje RDNA korzystają z wolniejszej warstwy "
"zgodności. Obecny Proton-GE wyłącza przy tym Anti-Lag 2."

#: src/launch-options/launch-option-catalog.vala:1298
msgid ""
"Requires a custom Proton build that advertises PROTON_FSR4_UPGRADE, a "
"supported game, and compatible AMD hardware/drivers"
msgstr ""
"Wymaga własnej kompilacji Protona zgłaszającej PROTON_FSR4_UPGRADE, "
"obsługiwanej gry oraz zgodnego sprzętu i sterowników AMD"

#: src/launch-options/launch-option-catalog.vala:1299
msgid "FSR 4 RDNA3 upgrade (legacy path)"
msgstr "Aktualizacja do FSR 4 dla RDNA3 (ścieżka starsza)"

#: src/launch-options/launch-option-catalog.vala:1299
msgid ""
"Uses the older RDNA3-specific upgrade switch retained by some Proton-GE "
"builds. New Proton-CachyOS releases removed it in favor of the current FSR 4 "
"path."
msgstr ""
"Używa starszego przełącznika przeznaczonego dla RDNA3, zachowanego w części "
"kompilacji Proton-GE. Nowe wydania Proton-CachyOS usunęły go na rzecz "
"obecnej ścieżki FSR 4."

#: src/launch-options/launch-option-catalog.vala:1299
msgid ""
"Only available when the selected custom Proton build still advertises this "
"legacy switch"
msgstr ""
"Dostępne tylko wtedy, gdy wybrana własna kompilacja Protona nadal zgłasza "
"ten przestarzały przełącznik"

#: src/launch-options/launch-option-catalog.vala:1300
msgid "FSR 4 ML frame generation"
msgstr "Generowanie klatek ML w FSR 4"

#: src/launch-options/launch-option-catalog.vala:1300
msgid ""
"Requests ML frame generation in supported custom Proton builds. Proton-"
"CachyOS requires FSR 4.0.3 or newer; RDNA3 may require "
"DXIL_SPIRV_CONFIG=wmma_rdna3_workaround. Proton-EM enables MLFG by default "
"with FSR 4 and uses value 0 to disable it."
msgstr ""
"Żąda generowania klatek ML w obsługiwanych własnych kompilacjach Protona. "
"Proton-CachyOS wymaga FSR 4.0.3 lub nowszego; na RDNA3 może być potrzebne "
"DXIL_SPIRV_CONFIG=wmma_rdna3_workaround. Proton-EM włącza MLFG domyślnie "
"razem z FSR 4 i wyłącza je wartością 0."

#: src/launch-options/launch-option-catalog.vala:1300
msgid ""
"Requires a custom Proton build that advertises MLFG, FSR 4.0.3 or newer, and "
"supported AMD hardware/drivers"
msgstr ""
"Wymaga własnej kompilacji Protona zgłaszającej MLFG, FSR 4.0.3 lub nowszego "
"oraz obsługiwanego sprzętu i sterowników AMD"

#: src/launch-options/launch-option-catalog.vala:1301
msgid "RDNA3 ML frame-generation workaround"
msgstr "Obejście generowania klatek ML na RDNA3"

#: src/launch-options/launch-option-catalog.vala:1301
msgid ""
"Enables the DXIL-SPIR-V WMMA workaround that some RDNA3 systems need for ML "
"frame generation. Do not use it on other GPU generations."
msgstr ""
"Włącza obejście DXIL-SPIR-V WMMA, potrzebne części systemów RDNA3 do "
"generowania klatek ML. Nie używaj go na innych generacjach kart."

#: src/launch-options/launch-option-catalog.vala:1301
msgid "RDNA3 only; enable only if ML frame generation requires it"
msgstr ""
"Tylko RDNA3; włączaj wyłącznie wtedy, gdy wymaga tego generowanie klatek ML"

#: src/launch-options/launch-option-catalog.vala:1302
msgid "AMD Reflex preset: allow DXVK-NVAPI"
msgstr "Ustawienie AMD Reflex: zezwól na DXVK-NVAPI"

#: src/launch-options/launch-option-catalog.vala:1302
msgid ""
"Allows DXVK-NVAPI on non-NVIDIA drivers. Try this least-invasive Reflex "
"compatibility preset first; the game must support Reflex and the low-latency "
"Vulkan layer must be active."
msgstr ""
"Zezwala na DXVK-NVAPI na sterownikach innych niż NVIDIA. Zacznij od tego "
"najmniej inwazyjnego ustawienia zgodności z Reflex; gra musi obsługiwać "
"Reflex, a warstwa Vulkan o niskich opóźnieniach musi być włączona."

#: src/launch-options/launch-option-catalog.vala:1302
#: src/launch-options/launch-option-catalog.vala:1303
#: src/launch-options/launch-option-catalog.vala:1304
#: src/launch-options/launch-option-catalog.vala:1305
msgid "AMD Reflex compatibility"
msgstr "Zgodność z AMD Reflex"

#: src/launch-options/launch-option-catalog.vala:1302
msgid "May not convince games that explicitly require an NVIDIA GPU"
msgstr "Może nie wystarczyć w grach, które wprost wymagają karty NVIDIA"

#: src/launch-options/launch-option-catalog.vala:1303
msgid "AMD Reflex preset: hide AMD GPU"
msgstr "Ustawienie AMD Reflex: ukryj kartę AMD"

#: src/launch-options/launch-option-catalog.vala:1303
msgid ""
"Makes DXVK hide the AMD GPU so some games expose Reflex. This fallback can "
"break FSR 4 and ML frame generation; use only if allowing DXVK-NVAPI is "
"insufficient."
msgstr ""
"Sprawia, że DXVK ukrywa kartę AMD, dzięki czemu część gier udostępnia "
"Reflex. To rozwiązanie awaryjne może zepsuć FSR 4 i generowanie klatek ML — "
"użyj go dopiero, gdy zezwolenie na DXVK-NVAPI nie wystarczy."

#: src/launch-options/launch-option-catalog.vala:1303
msgid "GPU spoofing can break FSR 4 and other vendor-specific paths"
msgstr ""
"Podszywanie się pod inną kartę może zepsuć FSR 4 i inne ścieżki zależne od "
"producenta"

#: src/launch-options/launch-option-catalog.vala:1304
msgid "AMD Reflex preset: force NVAPI"
msgstr "Ustawienie AMD Reflex: wymuś NVAPI"

#: src/launch-options/launch-option-catalog.vala:1304
msgid ""
"Forces Proton's NVAPI path for games that still hide Reflex. This invasive "
"fallback can break FSR 4 and should be used only after the safer presets "
"fail."
msgstr ""
"Wymusza ścieżkę NVAPI w Protonie dla gier, które nadal ukrywają Reflex. To "
"inwazyjne rozwiązanie awaryjne może zepsuć FSR 4 — używaj go dopiero, gdy "
"bezpieczniejsze ustawienia zawiodą."

#: src/launch-options/launch-option-catalog.vala:1304
msgid "Can break FSR 4 and game-specific GPU detection"
msgstr "Może zepsuć FSR 4 i wykrywanie karty przez grę"

#: src/launch-options/launch-option-catalog.vala:1305
msgid "AMD Reflex preset: layer NVIDIA spoof"
msgstr "Ustawienie AMD Reflex: podszywanie się pod NVIDIĘ w warstwie"

#: src/launch-options/launch-option-catalog.vala:1305
msgid ""
"Makes the low-latency Vulkan layer report an NVIDIA GPU. Upstream recommends "
"against this last-resort spoof because it can break Proton FSR 4."
msgstr ""
"Sprawia, że warstwa Vulkan o niskich opóźnieniach zgłasza kartę NVIDIA. "
"Twórcy odradzają to ostateczne podszywanie się, bo może zepsuć FSR 4 w "
"Protonie."

#: src/launch-options/launch-option-catalog.vala:1305
msgid "Last resort; can break FSR 4 and other GPU detection"
msgstr "Ostateczność; może zepsuć FSR 4 i inne mechanizmy wykrywania karty"

#: src/launch-options/launch-option-catalog.vala:1306
msgid "Treat APU as a discrete GPU"
msgstr "Traktuj APU jak kartę dedykowaną"

#: src/launch-options/launch-option-catalog.vala:1306
msgid ""
"Reports an AMD APU as a discrete GPU for games that mis-detect integrated "
"graphics."
msgstr ""
"Zgłasza APU AMD jako kartę dedykowaną — dla gier, które błędnie rozpoznają "
"grafikę zintegrowaną."

#: src/launch-options/launch-option-catalog.vala:1307
msgid "Vulkan driver"
msgstr "Sterownik Vulkan"

#: src/launch-options/launch-option-catalog.vala:1307
msgid "Chooses the AMD Vulkan driver for this game."
msgstr "Wybiera sterownik Vulkan dla kart AMD w tej grze."

#: src/launch-options/launch-option-catalog.vala:1308
msgid "Staging shared memory"
msgstr "Pamięć współdzielona buforów przejściowych"

#: src/launch-options/launch-option-catalog.vala:1308
msgid "Enables AMD driver shared memory support."
msgstr "Włącza obsługę pamięci współdzielonej w sterowniku AMD."

#: src/launch-options/launch-option-catalog.vala:1309
msgid "Mesa GL threading"
msgstr "Wielowątkowość GL w Mesa"

#: src/launch-options/launch-option-catalog.vala:1309
msgid "Enables Mesa GLThread."
msgstr "Włącza Mesa GLThread."

#: src/launch-options/launch-option-catalog.vala:1310
msgid "Mesa shader-cache control"
msgstr "Sterowanie pamięcią podręczną shaderów Mesa"

#: src/launch-options/launch-option-catalog.vala:1310
msgid "Controls Mesa's shader cache."
msgstr "Steruje pamięcią podręczną shaderów Mesa."

#: src/launch-options/launch-option-catalog.vala:1311
msgid "Experimental RADV features"
msgstr "Eksperymentalne funkcje RADV"

#: src/launch-options/launch-option-catalog.vala:1311
msgid "Tests experimental RADV performance features."
msgstr "Testuje eksperymentalne funkcje wydajnościowe RADV."

#: src/launch-options/launch-option-catalog.vala:1312
msgid "RADV workarounds and debugging"
msgstr "Obejścia i diagnostyka RADV"

#: src/launch-options/launch-option-catalog.vala:1312
msgid "Configure RADV compatibility workarounds and debugging."
msgstr "Konfiguracja obejść zgodności i diagnostyki RADV."

#: src/launch-options/launch-option-catalog.vala:1313
msgid "ACO shader-compiler debugging"
msgstr "Diagnostyka kompilatora shaderów ACO"

#: src/launch-options/launch-option-catalog.vala:1313
msgid "Configure AMD ACO shader compiler debugging."
msgstr "Konfiguracja diagnostyki kompilatora shaderów AMD ACO."

#: src/launch-options/launch-option-catalog.vala:1314
msgid "NVAPI"
msgstr "NVAPI"

#: src/launch-options/launch-option-catalog.vala:1314
msgid "Lets games access NVIDIA-specific features such as DLSS."
msgstr "Daje grom dostęp do funkcji NVIDII, takich jak DLSS."

#: src/launch-options/launch-option-catalog.vala:1314
#: src/launch-options/launch-option-catalog.vala:1315
#: src/launch-options/launch-option-catalog.vala:1316
#: src/launch-options/launch-option-catalog.vala:1317
#: src/launch-options/launch-option-catalog.vala:1318
#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:56
#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:75
msgid "NVIDIA"
msgstr "NVIDIA"

#: src/launch-options/launch-option-catalog.vala:1315
msgid "DLSS component updates"
msgstr "Aktualizacje komponentów DLSS"

#: src/launch-options/launch-option-catalog.vala:1315
msgid "Updates DLSS components for supported games."
msgstr "Aktualizuje komponenty DLSS w obsługiwanych grach."

#: src/launch-options/launch-option-catalog.vala:1316
msgid "DLSS indicator"
msgstr "Wskaźnik DLSS"

#: src/launch-options/launch-option-catalog.vala:1316
msgid "Shows an in-game DLSS status indicator."
msgstr "Pokazuje w grze wskaźnik stanu DLSS."

#: src/launch-options/launch-option-catalog.vala:1317
msgid "NVIDIA libraries"
msgstr "Biblioteki NVIDII"

#: src/launch-options/launch-option-catalog.vala:1317
msgid "Enables NVIDIA-specific libraries."
msgstr "Włącza biblioteki NVIDII."

#: src/launch-options/launch-option-catalog.vala:1318
msgid "Report GPU as AMD"
msgstr "Zgłaszaj kartę jako AMD"

#: src/launch-options/launch-option-catalog.vala:1318
msgid "Reports an NVIDIA GPU as AMD for affected games."
msgstr "Zgłasza kartę NVIDIA jako AMD w grach, których to dotyczy."

#: src/launch-options/launch-option-catalog.vala:1319
msgid "XeSS component upgrade"
msgstr "Aktualizacja komponentu XeSS"

#: src/launch-options/launch-option-catalog.vala:1319
msgid "Updates XeSS in supported games."
msgstr "Aktualizuje XeSS w obsługiwanych grach."

#: src/launch-options/launch-option-catalog.vala:1319
#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:57
#: src/widgets/games/launch-options-editor/groups/gpu-vendor-options-group.vala:79
msgid "Intel"
msgstr "Intel"

#. Input & audio
#: src/launch-options/launch-option-catalog.vala:1322
msgid "Prefer SDL controller input"
msgstr "Preferuj wejście kontrolera przez SDL"

#: src/launch-options/launch-option-catalog.vala:1322
msgid "Works around controller detection issues."
msgstr "Obchodzi problemy z wykrywaniem kontrolera."

#: src/launch-options/launch-option-catalog.vala:1323
msgid "Bypass Steam Input"
msgstr "Pomiń Steam Input"

#: src/launch-options/launch-option-catalog.vala:1323
msgid "Disables Steam Input support."
msgstr "Wyłącza obsługę Steam Input."

#: src/launch-options/launch-option-catalog.vala:1324
#: src/widgets/games/launch-options-editor/groups/audio-options-group.vala:20
msgid "PulseAudio latency"
msgstr "Opóźnienie PulseAudio"

#: src/launch-options/launch-option-catalog.vala:1324
msgid "Sets the PulseAudio latency target."
msgstr "Ustawia docelowe opóźnienie PulseAudio."

#: src/launch-options/launch-option-catalog.vala:1325
msgid "Wine ALSA output channels"
msgstr "Kanały wyjściowe ALSA w Wine"

#: src/launch-options/launch-option-catalog.vala:1325
msgid "Sets the Wine ALSA output channel count."
msgstr "Ustawia liczbę kanałów wyjściowych ALSA w Wine."

#: src/launch-options/launch-option-catalog.vala:1326
msgid "Wine ALSA spatial downmix"
msgstr "Miksowanie przestrzenne Wine ALSA"

#: src/launch-options/launch-option-catalog.vala:1326
msgid "Enables Wine ALSA spatial downmix for 4, 6, or 8 channels."
msgstr "Włącza miksowanie przestrzenne Wine ALSA dla 4, 6 lub 8 kanałów."

#: src/launch-options/launch-option-catalog.vala:1326
msgid "Requires 4, 6, or 8 output channels"
msgstr "Wymaga 4, 6 lub 8 kanałów wyjściowych"

#. Game arguments
#: src/launch-options/launch-option-catalog.vala:1329
msgid "Skip launcher"
msgstr "Pomiń okno startowe gry"

#: src/launch-options/launch-option-catalog.vala:1329
msgid "Adds -skip-launcher for games that support it."
msgstr "Dodaje -skip-launcher w grach, które to obsługują."

#: src/launch-options/launch-option-catalog.vala:1330
msgid "Vulkan renderer"
msgstr "Renderer Vulkan"

#: src/launch-options/launch-option-catalog.vala:1330
msgid "Adds -vulkan."
msgstr "Dodaje -vulkan."

#: src/launch-options/launch-option-catalog.vala:1331
msgid "DirectX 11 renderer"
msgstr "Renderer DirectX 11"

#: src/launch-options/launch-option-catalog.vala:1331
msgid "Adds -dx11."
msgstr "Dodaje -dx11."

#: src/launch-options/launch-option-catalog.vala:1332
msgid "DirectX 12 renderer"
msgstr "Renderer DirectX 12"

#: src/launch-options/launch-option-catalog.vala:1332
msgid "Adds -dx12."
msgstr "Dodaje -dx12."

#: src/launch-options/launch-option-catalog.vala:1333
msgid "Developer console"
msgstr "Konsola deweloperska"

#: src/launch-options/launch-option-catalog.vala:1333
msgid "Adds -console when the game supports it."
msgstr "Dodaje -console, jeśli gra to obsługuje."

#: src/launch-options/launch-option-catalog.vala:1334
#: src/widgets/games/launch-options-editor/groups/advanced-options-group.vala:19
msgid "Custom game arguments"
msgstr "Własne argumenty gry"

#: src/launch-options/launch-option-catalog.vala:1334
msgid ""
"Adds individual custom arguments and preserves unrecognized launch options "
"exactly as loaded."
msgstr ""
"Dodaje pojedyncze własne argumenty i zachowuje nierozpoznane parametry "
"startowe dokładnie w postaci wczytanej."

#: src/launch-options/launch-option-catalog.vala:1335
#, fuzzy
msgid "Custom wrapper"
msgstr "Własna nazwa GPU"

#: src/launch-options/launch-option-catalog.vala:1335
msgid "Run an executable or script before the Steam game command."
msgstr ""

#. Diagnostics & raw command
#: src/launch-options/launch-option-catalog.vala:1338
msgid "Proton debug log"
msgstr "Dziennik diagnostyczny Protona"

#: src/launch-options/launch-option-catalog.vala:1338
msgid "Enables Proton troubleshooting logs."
msgstr "Włącza dzienniki diagnostyczne Protona."

#: src/launch-options/launch-option-catalog.vala:1339
msgid "DXVK log level"
msgstr "Poziom rejestrowania DXVK"

#: src/launch-options/launch-option-catalog.vala:1339
msgid "Controls DXVK logging."
msgstr "Steruje rejestrowaniem w DXVK."

