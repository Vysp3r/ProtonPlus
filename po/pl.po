#~ "Używa FSync zamiast NTSync. Może naprawić problemy w grach, które źle "
#~ "współpracują z NTSync."

#~ msgid ""
#~ "Enables per-game shader cache. This isolates the shader cache of each "
#~ "game but does not compile them ahead-of-time."
#~ msgstr ""
#~ "Włącza osobną pamięć podręczną shaderów dla każdej gry. Oddziela je od "
#~ "siebie, ale nie kompiluje z wyprzedzeniem."

#~ msgid "Workaround for controller detection issues."
#~ msgstr "Obejście problemów z wykrywaniem kontrolera."

#~ msgid ""
#~ "Disables Steam Input support. Fixes Wayland controller/gamepad issues."
#~ msgstr ""
#~ "Wyłącza obsługę Steam Input. Naprawia problemy z kontrolerami na "
#~ "Waylandzie."

#~ msgid ""
#~ "Enables WINE_VK_USE_SYNC2 which can improve performance and reduce "
#~ "stuttering in some games when using WineD3D."
#~ msgstr ""
#~ "Włącza WINE_VK_USE_SYNC2, co przy WineD3D może w części gier poprawić "
#~ "wydajność i ograniczyć przycięcia."

#~ msgid ""
#~ "Enables WINE_SYNC_USE_FUTEX_WAITV which can improve performance and "
#~ "reduce stuttering in some games when using WineD3D."
#~ msgstr ""
#~ "Włącza WINE_SYNC_USE_FUTEX_WAITV, co przy WineD3D może w części gier "
#~ "poprawić wydajność i ograniczyć przycięcia."

#~ msgid "Simulate Write-Copy Memory"
#~ msgstr "Symuluj pamięć write-copy"

#~ msgid ""
#~ "Forces Wine to simulate page-write protection, fixing initialization "
#~ "errors in certain older titles."
#~ msgstr ""
#~ "Wymusza w Wine symulację ochrony zapisu stron, naprawiając błędy "
#~ "inicjalizacji w części starszych gier."

#~ msgid ""
#~ "Gives the game a higher CPU priority which can improve performance in "
#~ "some cases."
#~ msgstr ""
#~ "Nadaje grze wyższy priorytet procesora, co w niektórych przypadkach "
#~ "poprawia wydajność."

#~ msgid ""
#~ "Enables WoW64 support for 32-bit games on 64-bit Proton builds. This can "
#~ "improve compatibility for some older games."
#~ msgstr ""
#~ "Włącza obsługę WoW64 dla gier 32-bitowych w 64-bitowych kompilacjach "
#~ "Protona. Może to poprawić zgodność części starszych gier."

#~ msgid ""
#~ "Forces 32-bit games to use large address aware which can improve "
#~ "performance and stability."
#~ msgstr ""
#~ "Wymusza w grach 32-bitowych tryb dużych adresów, co może poprawić "
#~ "wydajność i stabilność."

#~ msgid ""
#~ "Enables logging for Proton which can help with troubleshooting game "
#~ "issues. Logs are saved in the game's compatibility data folder."
#~ msgstr ""
#~ "Włącza rejestrowanie zdarzeń Protona, pomocne przy diagnozowaniu "
#~ "problemów z grami. Dzienniki trafiają do katalogu danych zgodności gry."

#~ msgid ""
#~ "Enables the Proton OptiScaler which can improve performance and image "
#~ "quality for some games (Available from version 11-1)."
#~ msgstr ""
#~ "Włącza OptiScaler w Protonie, co w części gier poprawia wydajność i "
#~ "jakość obrazu (dostępne od wersji 11-1)."

#~ msgid ""
#~ "Enables the Proton Discord Bridge which can improve integration with "
#~ "Discord for some games (Available from version 11-1)."
