root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{vala,vapi}]
indent_style = space
indent_size = 4

[meson.build]
indent_style = space
indent_size = 4

[*.json]
indent_style = space
indent_size = 4

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
indent_size = tab

[{_build,build,build-*,builddir,.flatpak,.flatpak-builder,dist,tmp}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
