<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.vysp3r.ProtonPlus</id>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>ProtonPlus</name>
  <summary>Manage compatibility tools and launch games on Linux</summary>
  <description>
    <p>
      Install and update compatibility tools for Steam and other Linux game launchers. Browse installed games, launch them with their saved settings, and preview Steam launch options before applying them.
    </p>
    <ul>
      <li>Browse Proton, Wine, DXVK, VKD3D, and related tools by category and view installed builds for the selected launcher</li>
      <li>Manage tools for Steam, Faugus Launcher, Lutris, Heroic Games Launcher, Bottles, and WineZGUI</li>
      <li>Manage Proton builds and game profiles for Proton-Autogen</li>
      <li>Edit compatibility tools and launch options for one or more Steam games</li>
      <li>Launch games and open their folders in Lutris, Faugus Launcher, Heroic Games Launcher, and Bottles</li>
      <li>Change or reset compatible per-game runners in Lutris and Faugus Launcher</li>
      <li>Track downloads and updates, with cancellation and desktop notifications</li>
      <li>Navigate the app with a gamepad</li>
      <li>Search for runners, check for updates, and manage installations and the release cache from the command line</li>
    </ul>
  </description>

  <developer id="com.vysp3r">
    <name>Vysp3r</name>
  </developer>

  <keywords>
    <keyword>Proton</keyword>
    <keyword>Proton-Autogen</keyword>
    <keyword>Wine</keyword>
    <keyword>Steam</keyword>
    <keyword>Faugus</keyword>
    <keyword>Lutris</keyword>
    <keyword>Heroic</keyword>
    <keyword>Bottles</keyword>
    <keyword>DXVK</keyword>
    <keyword>VKD3D</keyword>
    <keyword>Steam Tinker Launch</keyword>
  </keywords>

  <url type="homepage">https://protonplus.vysp3r.com/</url>
  <url type="help">https://github.com/Vysp3r/ProtonPlus/tree/main/docs</url>
  <url type="vcs-browser">https://github.com/Vysp3r/ProtonPlus</url>
  <url type="bugtracker">https://github.com/Vysp3r/ProtonPlus/issues</url>
  <url type="translate">https://hosted.weblate.org/projects/protonplus/protonplus</url>
  <url type="donation">https://protonplus.vysp3r.com/#donate</url>

  <categories>
    <category>Game</category>
    <category>GameTool</category>
  </categories>

  <provides>
    <binary>protonplus</binary>
  </provides>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
    <control>gamepad</control>
  </supports>

  <translation type="gettext">com.vysp3r.ProtonPlus</translation>

  <launchable type="desktop-id">com.vysp3r.ProtonPlus.desktop</launchable>

  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#e39090</color>
    <color type="primary" scheme_preference="dark">#993d3d</color>
  </branding>

