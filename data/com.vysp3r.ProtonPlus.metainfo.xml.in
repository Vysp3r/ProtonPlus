  <releases>
    <release version="0.6.9" date="2026-11-25">
      <url type="details">https://github.com/Vysp3r/ProtonPlus/releases/tag/v0.6.9</url>
      <description>
        <ul>
          <li>✨ Refined Tools and Games, improved download progress, and added an in-app Help guide</li>
          <li>✨ Added automatic download retries and resume, plus an optional HTTPS mirror for GitHub release assets</li>
          <li>✨ Added native Linux packages and SHA-256 checksums to GitHub Releases</li>
          <li>✨ Added Proton-Autogen, TinkerGame, and Rosemary support</li>
          <li>✨ Added Games support for Lutris, Faugus Launcher, Heroic Games Launcher, and Bottles, with runner editing in Lutris and Faugus</li>
          <li>✨ Added CLI runner search, update checks, and release cache maintenance</li>
          <li>🐛 Improved Steam game discovery and restart handling</li>
          <li>🐛 Fixed custom launch wrappers appearing after the Steam command</li>
          <li>🐛 Hardened tool installation and updates, including symlinked directories and provider renames</li>
          <li>🔄 Updated the Flatpak runtime to GNOME 51 and removed the built-in MangoHud configuration editor</li>
          <li>🌐 Updated translations and improved plural labels</li>
        </ul>
        <p>TinkerGame requires native ProtonPlus and native Steam outside SteamOS.</p>
      </description>
    </release>
    <release version="0.6.8" date="2026-09-08">
      <description>
        <ul>
          <li>✨ Added a Discord community link to the About dialog</li>
          <li>🐛 Fixed some release changelogs failing to render when inline code contains Markdown emphasis characters</li>
          <li>🐛 Fixed the Steam restart notification missing its icon</li>
          <li>🌐 Updated Polish localization</li>
        </ul>
      </description>
    </release>
    <release version="0.6.7" date="2026-09-08">
      <description>
        <ul>
          <li>🐛 Fixed Proton-Wineland WoW64 releases not being detected</li>
          <li>🔄 Renamed Proton-CachyOS Wineland to Proton-Wineland</li>
          <li>🌐 Updated Polish, Russian, and Spanish localizations</li>
        </ul>
      </description>
    </release>
    <release version="0.6.6" date="2026-09-04">
      <description>
        <ul>
          <li>🐛 Fixed scheduled tool updates not working when ProtonPlus is installed as a Flatpak</li>
          <li>🌐 Updated Spanish and Indonesian localizations</li>
        </ul>
      </description>
    </release>
    <release version="0.6.5" date="2026-08-30">
      <description>
        <ul>
          <li>🐛 Fixed release catalogs sometimes remaining stale until application data was refreshed manually</li>
          <li>🌐 Updated Czech, German, French, Portuguese, Russian, Japanese, and Spanish localizations</li>
        </ul>
      </description>
    </release>
    <release version="0.6.4" date="2026-08-13">
      <description>
        <ul>
          <li>✨ Redesigned the interface to adapt better to different window sizes</li>
          <li>✨ Made tool releases easier to browse without leaving the tools list</li>
          <li>✨ Added sortable columns and improved selection in the Games view</li>
          <li>🐛 Improved controller navigation and scrolling in Tools and Games</li>
          <li>🐛 Improved compatibility with light, dark, and custom themes</li>
          <li>🐛 Prevented compatibility tools from being updated or removed while they are in use</li>
          <li>🐛 Fixed unrelated background processes sometimes blocking compatibility tool changes</li>
          <li>🐛 Fixed SteamOS Gaming Mode being detected in regular desktop sessions</li>
          <li>🐛 Fixed YAD 15 sometimes not being detected before installing SteamTinkerLaunch</li>
          <li>🐛 Fixed controller access on systems with older Flatpak versions</li>
          <li>🐛 Fixed Anti-Cheat information getting stuck on Loading for unlisted games</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
